@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<!-- Fullscreen 100% Width & Height Split-Screen Container -->
<div class="auth-fullscreen-split">
    <!-- Section 1 (Left): Welcoming & Adventure Pane (Full Height) -->
    <div class="auth-split-left">
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Rahhala_White.svg" alt="Rahhala" class="auth-welcome-logo" />
            </a>
            <span class="brand-tag">
                Outdoor Club & Camping Gear
            </span>
            <h2>Need Help With Your Account?</h2>
            <p class="lead-text">
                Don't worry, explorer! Enter your registered email address and we'll send you secure instructions to reset your password and get you back on your trail.
            </p>

            <ul class="auth-perks-list">
                <li>
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Secure & Encrypted Password Reset</span>
                </li>
                <li>
                    <i class="bi bi-envelope-check-fill"></i>
                    <span>Instant Recovery Link Sent to Your Inbox</span>
                </li>
                <li>
                    <i class="bi bi-compass-fill"></i>
                    <span>24/7 Adventure & Account Support</span>
                </li>
            </ul>
        </div>

        <div class="auth-welcome-footer">
            <i class="bi bi-quote fs-4 text-primary me-1 align-middle"></i>
            <em>"Every mountain top is within reach if you just keep climbing."</em>
        </div>
    </div>

    <!-- Section 2 (Right): Forgot Password Form Pane (Full Height) -->
    <div class="auth-split-right">
        <!-- Internal Top Navigation Inside Right Pane -->
        <div class="auth-internal-nav">
            <div class="d-lg-none">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo_Barrameru.png" alt="Barrameru" style="height: 32px;" />
                </a>
            </div>
            <a asp-page="./Login" class="auth-box-back-btn">
                <span class="btn-icon-circle"><i class="bi bi-arrow-left"></i></span>
                <span>Back to Sign In</span>
            </a>
        </div>

        <!-- Form Centered Wrapper -->
        <div class="auth-right-content-wrap">
            <div class="auth-form-header">
                <span class="sub-badge text-teal" style="font-size: 14px;">Account Recovery</span>
                <h3>Forgot Password?</h3>
                <p>Enter the email address associated with your Barrameru account.</p>
            </div>

            <!-- Validation Errors -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small py-2 mb-3" role="alert"></div>

            <form method="post">
                <!-- Email Input -->
                <div class="auth-input-group mb-4">
                    <input asp-for="Input.Email" class="form-control" placeholder="Email Address" autocomplete="email" aria-required="true" autofocus />
                    <i class="bi bi-envelope-fill input-icon"></i>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn-submit">
                    SEND RESET LINK <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </form>

            <!-- Footer / Back to Login Link -->
            <div class="auth-footer-link mt-4">
                Remembered your password?
                <a asp-page="./Login">Sign In to Your Account</a>
            </div>
        </div>

        <!-- Bottom Spacing / Alignment Anchor -->
        <div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
