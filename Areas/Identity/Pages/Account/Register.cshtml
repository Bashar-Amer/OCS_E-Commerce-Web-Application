@page
@model RegisterModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<!-- Fullscreen 100% Width & Height Split-Screen Container -->
<div class="auth-fullscreen-split">
    <!-- Section 1 (Left): Welcoming & Adventure Pane (Full Height) -->
    <div class="auth-split-left">
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Barrameru.png" alt="Rahhala" class="auth-welcome-logo" />
            </a>
            <span class="brand-tag">
                Outdoor Club & Camping Gear
            </span>
            <h2>Join The Expedition!</h2>
            <p class="lead-text">
                Create your Barrameru account today to unlock curated outdoor gear recommendations, fast checkout, order tracking, and exclusive explorer discounts.
            </p>

            <ul class="auth-perks-list">
                <li>
                    <i class="bi bi-shield-check"></i>
                    <span>100% Authentic Camping & Hiking Gear</span>
                </li>
                <li>
                    <i class="bi bi-truck"></i>
                    <span>Fast Dispatch & Real-Time Order Tracking</span>
                </li>
                <li>
                    <i class="bi bi-heart-fill"></i>
                    <span>Save Favorite Equipment to Wishlist</span>
                </li>
            </ul>
        </div>

        <div class="auth-welcome-footer">
            <i class="bi bi-quote fs-4 text-primary me-1 align-middle"></i>
            <em>"Free your spirit, break the chains, Go camp!"</em>
        </div>
    </div>

    <!-- Section 2 (Right): Registration Form Pane (Full Height) -->
    <div class="auth-split-right">
        <!-- Internal Top Navigation Inside Right Pane -->
        <div class="auth-internal-nav">
            <div class="d-lg-none">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo_Barrameru.png" alt="Barrameru" style="height: 32px;" />
                </a>
            </div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-box-back-btn">
                <span class="btn-icon-circle"><i class="bi bi-arrow-left"></i></span>
                <span>Back to Store</span>
            </a>
        </div>

        <!-- Form Centered Wrapper -->
        <div class="auth-right-content-wrap">
            <div class="auth-form-header">
                <span class="sub-badge text-teal" style="font-size: 14px;">New Explorer</span>
                <h3>Create Account</h3>
                <p>Fill in your details below to register a new account.</p>
            </div>

            <!-- Validation Errors -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small py-2 mb-3" role="alert"></div>

            <form id="accountRegisterForm" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <!-- 1. Full Name Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.FullName" class="form-control" placeholder="Full Name" autocomplete="name" aria-required="true" />
                    <i class="bi bi-person-fill input-icon"></i>
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>

                <!-- 2. Email Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.Email" class="form-control" placeholder="Email Address" autocomplete="username" aria-required="true" />
                    <i class="bi bi-envelope-fill input-icon"></i>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- 3. Phone Number Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone Number" autocomplete="tel" aria-required="true" />
                    <i class="bi bi-telephone-fill input-icon"></i>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                </div>

                <!-- 4. Password Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.Password" class="form-control" id="registerPassInput" placeholder="Password" autocomplete="new-password" aria-required="true" />
                    <i class="bi bi-lock-fill input-icon"></i>
                    <button type="button" class="password-toggle-btn" id="toggleRegisterPassBtn" title="Show / Hide Password">
                        <i class="bi bi-eye-fill"></i>
                    </button>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <!-- 5. Confirm Password Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.ConfirmPassword" class="form-control" id="registerConfirmInput" placeholder="Confirm Password" autocomplete="new-password" aria-required="true" />
                    <i class="bi bi-shield-lock-fill input-icon"></i>
                    <button type="button" class="password-toggle-btn" id="toggleRegisterConfirmBtn" title="Show / Hide Password">
                        <i class="bi bi-eye-fill"></i>
                    </button>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- Submit Button -->
                <button id="register-submit" type="submit" class="auth-btn-submit">
                    CREATE ACCOUNT <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="my-3 text-center">
                    <span class="text-muted small text-uppercase">Or register with</span>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-2">
                        <div class="d-flex justify-content-center gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary rounded-0 btn-sm" name="provider" value="@provider.Name">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                </div>
            }

            <!-- Footer / Login Link -->
            <div class="auth-footer-link">
                Already have an outdoor account?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign In Here</a>
            </div>
        </div>

        <!-- Bottom Spacing / Alignment Anchor -->
        <div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/register.js" asp-append-version="true"></script>
}
