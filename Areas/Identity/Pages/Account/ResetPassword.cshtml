@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<!-- Fullscreen 100% Width & Height Split-Screen Container -->
<div class="auth-fullscreen-split">
    <!-- Section 1 (Left): Welcoming & Adventure Pane (Full Height) -->
    <div class="auth-split-left">
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Barrameru.png" alt="Rahhala" class="auth-welcome-logo" />
            </a>
            <span class="brand-tag">
                Outdoor Club & Camping Gear
            </span>
            <h2>Choose Your New Password</h2>
            <p class="lead-text">
                Create a strong and secure password to protect your outdoor gear wishlist, saved delivery addresses, and expedition order history.
            </p>

            <ul class="auth-perks-list">
                <li>
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Minimum 6 Characters</span>
                </li>
                <li>
                    <i class="bi bi-key-fill"></i>
                    <span>Use a combination of letters & numbers</span>
                </li>
            </ul>
        </div>

        <div class="auth-welcome-footer">
            <i class="bi bi-quote fs-4 text-primary me-1 align-middle"></i>
            <em>"Free your spirit, break the chains, Go camp!"</em>
        </div>
    </div>

    <!-- Section 2 (Right): Reset Password Form Pane (Full Height) -->
    <div class="auth-split-right">
        <!-- Internal Top Navigation -->
        <div class="auth-internal-nav">
            <div class="d-lg-none">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo_Barrameru.png" alt="Barrameru" style="height: 32px;" />
                </a>
            </div>
            <a asp-page="./Login" class="auth-box-back-btn">
                <span class="btn-icon-circle"><i class="bi bi-arrow-left"></i></span>
                <span>Back to Sign In</span>
            </a>
        </div>

        <!-- Form Centered Wrapper -->
        <div class="auth-right-content-wrap">
            <div class="auth-form-header">
                <span class="sub-badge text-teal" style="font-size: 14px;">Security Update</span>
                <h3>Reset Password</h3>
                <p>Enter your email address and choose a new password.</p>
            </div>

            <!-- Validation Errors -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small py-2 mb-3" role="alert"></div>

            <form method="post">
                <input asp-for="Input.Code" type="hidden" />

                <!-- Email Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.Email" class="form-control" placeholder="Email Address" autocomplete="username" aria-required="true" />
                    <i class="bi bi-envelope-fill input-icon"></i>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- New Password Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.Password" class="form-control" id="resetPasswordInput" placeholder="New Password" autocomplete="new-password" aria-required="true" />
                    <i class="bi bi-lock-fill input-icon"></i>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <!-- Confirm Password Input -->
                <div class="auth-input-group mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" id="resetConfirmPasswordInput" placeholder="Confirm New Password" autocomplete="new-password" aria-required="true" />
                    <i class="bi bi-shield-check input-icon"></i>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- Large Submit Button -->
                <button type="submit" class="auth-btn-submit">
                    UPDATE PASSWORD <i class="bi bi-check2-circle ms-2"></i>
                </button>
            </form>

            <!-- Footer / Sign In Link -->
            <div class="auth-footer-link mt-4">
                Already know your password?
                <a asp-page="./Login">Sign In Here</a>
            </div>
        </div>

        <!-- Bottom Spacing / Alignment Anchor -->
        <div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
