@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password Reset Link Sent";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<!-- Fullscreen 100% Width & Height Split-Screen Container -->
<div class="auth-fullscreen-split">
    <!-- Section 1 (Left): Welcoming & Adventure Pane (Full Height) -->
    <div class="auth-split-left">
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Barrameru_2.png" alt="Rahhala" class="auth-welcome-logo" />
            </a>
            <span class="brand-tag">
                Outdoor Club & Camping Gear
            </span>
            <h2>Check Your Inbox, Explorer!</h2>
            <p class="lead-text">
                We've dispatched recovery instructions to your email address. Follow the link in the message to securely choose a new password.
            </p>
        </div>

        <div class="auth-welcome-footer">
            <i class="bi bi-quote fs-4 text-primary me-1 align-middle"></i>
            <em>"Free your spirit, break the chains, Go camp!"</em>
        </div>
    </div>

    <!-- Section 2 (Right): Confirmation Box Pane (Full Height) -->
    <div class="auth-split-right">
        <!-- Internal Top Navigation -->
        <div class="auth-internal-nav">
            <div></div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-box-back-btn">
                <span class="btn-icon-circle"><i class="bi bi-arrow-left"></i></span>
                <span>Back to Store</span>
            </a>
        </div>

        <!-- Content Centered Wrapper -->
        <div class="auth-right-content-wrap text-center">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background-color: #E2ECE9; color: var(--admin-primary);">
                    <i class="bi bi-envelope-paper-heart-fill fs-2"></i>
                </div>
            </div>

            <div class="auth-form-header mb-4">
                <span class="sub-badge text-teal" style="font-size: 14px;">Email Sent</span>
                <h3>Password Reset Link Sent</h3>
                <p>
                    Please check your email for the password reset link. Be sure to check your spam/junk folder if it doesn't appear in a few moments.
                </p>
            </div>

            <div class="d-grid gap-2 mb-4">
                <a asp-page="./Login" class="auth-btn-submit text-decoration-none text-center">
                    BACK TO SIGN IN <i class="bi bi-box-arrow-in-right ms-2"></i>
                </a>
            </div>

            <div class="auth-footer-link">
                Didn't receive an email?
                <a asp-page="./ForgotPassword">Try another email address</a>
            </div>
        </div>

        <!-- Bottom Spacing / Alignment Anchor -->
        <div></div>
    </div>
</div>
