@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<!-- Fullscreen 100% Width & Height Split-Screen Container -->
<div class="auth-fullscreen-split">
    <!-- Section 1 (Left): Welcoming & Adventure Pane (Full Height) -->
    <div class="auth-split-left">
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Barrameru.png" alt="Barrameru" class="auth-welcome-logo" />
            </a>
            <span class="brand-tag">
                Outdoor Club & Camping Gear
            </span>
            <h2>Welcome Back, Explorer!</h2>
            <p class="lead-text">
                Sign in to access your saved equipment wishlist, track active expedition orders, and manage your outdoor gear preferences.
            </p>

            <ul class="auth-perks-list">
                <li>
                    <i class="bi bi-shield-check"></i>
                    <span>100% Authentic Camping & Hiking Gear</span>
                </li>
                <li>
                    <i class="bi bi-truck"></i>
                    <span>Fast Dispatch & Real-Time Order Tracking</span>
                </li>
                <li>
                    <i class="bi bi-heart-fill"></i>
                    <span>Save Favorite Equipment to Wishlist</span>
                </li>
            </ul>
        </div>

        <div class="auth-welcome-footer">
            <i class="bi bi-quote fs-4 text-primary me-1 align-middle"></i>
            <em>"Free your spirit, break the chains, Go camp!"</em>
        </div>
    </div>

    <!-- Section 2 (Right): Sign In Form Pane (Full Height) -->
    <div class="auth-split-right">
        <!-- Internal Top Navigation Inside Right Pane -->
        <div class="auth-internal-nav">
            <div></div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-box-back-btn">
                <span class="btn-icon-circle"><i class="bi bi-arrow-left"></i></span>
                <span>Back to Store</span>
            </a>
        </div>

        <!-- Form Centered Wrapper -->
        <div class="auth-right-content-wrap">
            <div class="auth-form-header">
                <span class="sub-badge text-teal" style="font-size: 14px;">Member Access</span>
                <h3>Sign In</h3>
                <p>Enter your credentials to access your account & orders.</p>
            </div>

            <!-- Validation Errors -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small py-2 mb-3" role="alert"></div>

            <form id="accountLoginForm" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <!-- Email Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.Email" class="form-control" id="emailInput" placeholder="Email Address" autocomplete="username" aria-required="true" />
                    <i class="bi bi-envelope-fill input-icon"></i>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- Password Input -->
                <div class="auth-input-group">
                    <input asp-for="Input.Password" class="form-control" id="passwordInput" placeholder="Password" autocomplete="current-password" aria-required="true" />
                    <i class="bi bi-lock-fill input-icon"></i>
                    <button type="button" class="password-toggle-btn" id="togglePasswordBtn" title="Show / Hide Password">
                        <i class="bi bi-eye-fill"></i>
                    </button>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <label class="form-check-label small d-flex align-items-center gap-2 cursor-pointer">
                        <input class="form-check-input auth-checkbox m-0" asp-for="Input.RememberMe" />
                        <span class="text-secondary fw-semibold">Remember me</span>
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="small text-muted text-decoration-none">Forgot password?</a>
                </div>

                <!-- Large Submit Button -->
                <button id="login-submit" type="submit" class="auth-btn-submit">
                    SIGN IN <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="my-3 text-center">
                    <span class="text-muted small text-uppercase">Or continue with</span>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-2">
                        <div class="d-flex justify-content-center gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary rounded-0 btn-sm" name="provider" value="@provider.Name">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                </div>
            }

            <!-- Demo Credentials Helper for Quick Testing -->
            <div class="demo-accounts-box">
                <div class="fw-bold text-secondary mb-2 d-flex align-items-center gap-1" style="font-size: 12px;">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> 1-Click Instant Demo Login:
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="demo-account-pill text-start" data-email="admin@barrameru.com" data-pass="Admin@123!" title="Instant Sign In as Admin">
                        <i class="bi bi-shield-lock-fill text-primary me-1"></i> <strong>Admin:</strong> admin@barrameru.com
                    </button>
                    <button type="button" class="demo-account-pill text-start" data-email="john.doe@example.com" data-pass="Customer@123!" title="Instant Sign In as Customer">
                        <i class="bi bi-person-fill text-teal me-1"></i> <strong>Customer:</strong> john.doe@example.com
                    </button>
                </div>
            </div>

            <!-- Footer / Register Link -->
            <div class="auth-footer-link">
                Don't have an outdoor account yet?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Join Us & Create Account</a>
            </div>
        </div>

        <!-- Bottom Spacing / Alignment Anchor -->
        <div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/login.js" asp-append-version="true"></script>
}
