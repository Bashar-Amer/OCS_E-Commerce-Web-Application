@page
@model PostLoginSyncModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet">
    <title>Signing you in…</title>

    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
    }
    <meta name="request-verification-token" content="@token" />
</head>
<body>
    <div class="text-center" style="margin-top: 20vh;">
        <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h2 class="mt-4">Please wait...</h2>
        <p class="text-muted">We are processing your request. This may take a few moments.</p>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    
    <script>
            // async function getAntiForgeryToken() {
            //     const res = await fetch('/Cart/GetAntiForgeryToken');
            //     const data = await res.json();
            //     return data.token;
            // }

            async function mergeGuestCart() {
                const raw = localStorage.getItem('barrameru_cart_guest');
                if (!raw) return;

                const guestItems = JSON.parse(raw);
                if (!guestItems || !guestItems.length) {
                    console.log("No items");
                    return;
                }

                const items = guestItems.map(item => ({
                    ProductId: item.id,
                    Quantity: item.quantity
                }));

                const token = document.querySelector('meta[name="request-verification-token"]').content;

                const res = await fetch('/Cart/MergeGuestCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(items)
                });

                if (res.ok){
                    localStorage.removeItem('barrameru_cart_guest');
                    console.log("MergeGuestCart success");
                }
                 else 
                    throw new Error(`MergeGuestCart failed with status ${res.status}`);
            }

            (async function() {
                try {
                    await mergeGuestCart();
                } catch (e) {
                    console.error('Cart merge failed', e);
                } finally {
                    window.location.href = @Html.Raw(Json.Serialize(Model.ReturnUrl));
                }
            })();
    </script>
</body>
</html>