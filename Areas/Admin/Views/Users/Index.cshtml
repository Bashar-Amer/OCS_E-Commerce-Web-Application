@model CampTravelGear.Helpers.PaginatedList<CampTravelGear.Data.ApplicationUser>

@{
    ViewData["Title"] = "Registered Users";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color: var(--admin-text-main);">Registered Users</h1>
        <p class="text-muted small mb-0" style="font-size: 12px;">Directory of registered customers, store members, and administrators.</p>
    </div>
</div>

<!-- Users Table Card -->
<div class="admin-card">
    <div class="admin-card-header py-2 px-3">
        <div class="d-flex align-items-center gap-2">
            <div class="admin-card-title" style="font-size: 13.5px;">
                <i class="bi bi-people-fill text-primary"></i>
                <span>User Accounts</span>
                <span class="admin-badge admin-badge-teal ms-1">@Model.TotalCount Total</span>
            </div>
        </div>

        <div class="admin-search-input">
            <i class="bi bi-search"></i>
            <input type="text" id="userSearchInput" placeholder="Filter by name, email, phone, or ID..." />
        </div>
    </div>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>User / Customer</th>
                    <th>Email Address</th>
                    <th>Phone Number</th>
                    <th>Account Status</th>
                    <th style="width: 220px;">User ID</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        var displayName = user.FullName ?? user.UserName ?? "Member";
                        var email = user.Email ?? "No email recorded";
                        var phone = user.PhoneNumber ?? "Not provided";
                        var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";

                        <tr class="user-row">
                            <!-- Customer Profile -->
                            <td class="user-name-cell">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0" 
                                         style="width: 34px; height: 34px; background-color: var(--admin-primary); font-size: 12px;">
                                        @initial
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-truncate" style="color: var(--admin-text-main); font-size: 12.5px; max-width: 190px;">
                                            @displayName
                                        </span>
                                        <span class="text-muted d-block text-truncate" style="font-size: 11px; max-width: 190px;">
                                            @@@user.UserName
                                        </span>
                                    </div>
                                </div>
                            </td>

                            <!-- Email Address -->
                            <td class="user-email-cell">
                                <a href="mailto:@email" class="text-decoration-none fw-semibold small" style="color: var(--admin-text-main); font-size: 12px;">
                                    <i class="bi bi-envelope me-1 text-primary"></i>@email
                                </a>
                            </td>

                            <!-- Phone Number -->
                            <td class="user-phone-cell">
                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                {
                                    <span class="small" style="font-size: 12px; color: var(--admin-text-main);">
                                        <i class="bi bi-telephone me-1 text-muted"></i>@phone
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small" style="font-size: 11.5px;">
                                        <em>Not provided</em>
                                    </span>
                                }
                            </td>

                            <!-- Account Status / Badge -->
                            <td>
                                <span class="admin-badge admin-badge-success">
                                    <i class="bi bi-check-circle-fill"></i> Active Member
                                </span>
                            </td>

                            <!-- Truncated User ID -->
                            <td class="user-id-cell">
                                <code class="small text-muted" style="font-size: 11px;" title="@user.Id">
                                    @(user.Id.Length > 18 ? user.Id.Substring(0, 18) + "..." : user.Id)
                                </code>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            <div class="text-muted">
                                <i class="bi bi-people fs-2 d-block mb-1 text-muted opacity-50"></i>
                                <p class="fw-semibold mb-1 small">No user accounts found in the database.</p>
                            </div>
                        </td>
                    </tr>
                }
                <tr id="noUserMatchRow" style="display: none;">
                    <td colspan="5" class="text-center py-3 text-muted small">
                        <i class="bi bi-search me-1"></i> No matching users found for your search query.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Standard Reusable Pagination Partial -->
    <partial name="_AdminPagination" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin/users.js" asp-append-version="true"></script>
}
