@model CampTravelGear.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="mb-3">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-action="Index" class="btn-admin-outline py-1 px-2" style="font-size: 11.5px;">
            <i class="bi bi-arrow-left me-1"></i> Back to Categories
        </a>
    </div>
    <h1 class="h4 fw-bold mb-1" style="color: var(--admin-text-main);">Add New Category</h1>
    <p class="text-muted small mb-0" style="font-size: 12px;">Create a new product grouping for the outdoor store catalog.</p>
</div>

<div class="row g-3">
    <!-- Main Form Column -->
    <div class="col-lg-8 col-xl-7">
        <div class="admin-card">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13.5px;">
                    <i class="bi bi-folder-plus text-primary"></i>
                    <span>Category Information</span>
                </div>
            </div>

            <div class="admin-card-body p-3">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small py-1 px-2 mb-2" role="alert"></div>

                    <!-- Category Name Field -->
                    <div class="admin-form-group mb-3">
                        <label asp-for="Name" class="admin-form-label">
                            Category Name <span class="text-danger">*</span>
                        </label>
                        <div class="admin-input-group">
                            <div class="input-icon-box">
                                <i class="bi bi-tag-fill"></i>
                            </div>
                            <input asp-for="Name" class="admin-form-control" placeholder="e.g. Backpacks & Daypacks" autocomplete="off" autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                        <div class="form-text text-muted small mt-1" style="font-size: 11px;">
                            Use a concise, distinct category name for the shop navigation bar and filters.
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center gap-2 pt-2 border-top mt-3">
                        <button type="submit" class="btn-admin-primary">
                            <i class="bi bi-check2-circle"></i> Save Category
                        </button>
                        <a asp-action="Index" class="btn-admin-outline">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Helpful Tips Column -->
    <div class="col-lg-4 col-xl-5">
        <div class="admin-card border-0" style="background-color: #F0FDFA; border: 1.5px dashed var(--admin-accent-teal) !important;">
            <div class="admin-card-body p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-lightbulb-fill text-primary fs-6"></i>
                    <span class="fw-bold" style="color: var(--admin-text-main); font-size: 12.5px;">Category Best Practices</span>
                </div>
                <ul class="list-unstyled small text-secondary mb-0" style="font-size: 11.5px;">
                    <li class="mb-1 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <span>Keep titles clear (e.g. <em>"Camp Kitchen"</em>, <em>"Tents & Shelters"</em>).</span>
                    </li>
                    <li class="mb-1 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <span>You can assign products to this category in the <strong>Products</strong> section.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-shield-lock-fill text-primary mt-1"></i>
                        <span>Categories must have unique names.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
