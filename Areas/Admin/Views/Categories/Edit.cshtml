@model CampTravelGear.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="mb-3">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-action="Index" class="btn-admin-outline py-1 px-2" style="font-size: 11.5px;">
            <i class="bi bi-arrow-left me-1"></i> Back to Categories
        </a>
    </div>
    <h1 class="h4 fw-bold mb-1" style="color: var(--admin-text-main);">Edit Category</h1>
    <p class="text-muted small mb-0" style="font-size: 12px;">Modify category details for <strong class="text-dark">@Model.Name</strong>.</p>
</div>

<div class="row g-3">
    <!-- Main Form Column -->
    <div class="col-lg-8 col-xl-7">
        <div class="admin-card">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13.5px;">
                    <i class="bi bi-pencil-square text-primary"></i>
                    <span>Category Information</span>
                </div>
                <span class="admin-badge admin-badge-teal">ID #@Model.Id</span>
            </div>

            <div class="admin-card-body p-3">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Hidden Fields -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="IsDeleted" />

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small py-1 px-2 mb-2" role="alert"></div>

                    <!-- Category Name Field -->
                    <div class="admin-form-group mb-3">
                        <label asp-for="Name" class="admin-form-label">
                            Category Name <span class="text-danger">*</span>
                        </label>
                        <div class="admin-input-group">
                            <div class="input-icon-box">
                                <i class="bi bi-tag-fill"></i>
                            </div>
                            <input asp-for="Name" class="admin-form-control" placeholder="e.g. Backpacks & Daypacks" autocomplete="off" autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center gap-2 pt-2 border-top mt-3">
                        <button type="submit" class="btn-admin-primary">
                            <i class="bi bi-check2-circle"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn-admin-outline">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Metadata & Details Column -->
    <div class="col-lg-4 col-xl-5">
        <div class="admin-card">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13px;">
                    <i class="bi bi-info-circle text-primary"></i>
                    <span>Category Details</span>
                </div>
            </div>
            <div class="admin-card-body p-3">
                <div class="mb-2 pb-2 border-bottom">
                    <div class="text-muted small mb-1" style="font-size: 11px;">Category Record</div>
                    <div class="fw-semibold small" style="color: var(--admin-text-main); font-size: 11.5px;">
                        <i class="bi bi-tag me-1 text-primary"></i> @Model.Name
                    </div>
                </div>
                <div>
                    <div class="text-muted small mb-1" style="font-size: 11px;">Original Creation Date</div>
                    <div class="fw-semibold small" style="color: var(--admin-text-main); font-size: 11.5px;">
                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                        @Model.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
