@model (List<CampTravelGear.Data.ApplicationUser> Users, List<CampTravelGear.Models.Category> Categories, List<CampTravelGear.Models.Product> Products, List<CampTravelGear.Models.Order> Orders)

@{
    ViewData["Title"] = "Admin Dashboard";

    // Dashboard Calculations
    var totalRevenue = Model.Orders.Where(o => !string.Equals(o.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).Sum(o => o.TotalAmount);
    var totalOrders = Model.Orders.Count;
    var totalProducts = Model.Products.Count;
    var totalUsers = Model.Users.Count;
    var processingOrders = Model.Orders.Count(o => string.Equals(o.Status, "Processing", StringComparison.OrdinalIgnoreCase));
    var completedOrders = Model.Orders.Count(o => string.Equals(o.Status, "Completed", StringComparison.OrdinalIgnoreCase));

    var recentOrders = Model.Orders.OrderByDescending(o => o.Id).Take(5).ToList();
    var lowStockProducts = Model.Products.Where(p => p.Stock <= 10).OrderBy(p => p.Stock).Take(4).ToList();

    // Prepare Category Data for Chart.js
    var categoryLabels = Model.Categories.Select(c => c.Name).ToList();
    var categoryCounts = Model.Categories.Select(c => Model.Products.Count(p => p.CategoryId == c.Id)).ToList();
    var categoryLabelsJson = System.Text.Json.JsonSerializer.Serialize(categoryLabels);
    var categoryCountsJson = System.Text.Json.JsonSerializer.Serialize(categoryCounts);

    // Calculate Real Monthly Revenue from Database Orders (Last 6 Months)
    var last6Months = Enumerable.Range(0, 6)
        .Select(i => DateTime.UtcNow.AddMonths(-5 + i))
        .ToList();

    var realMonthLabels = last6Months.Select(d => d.ToString("MMM yyyy")).ToList();
    var realRevenuePoints = last6Months.Select(d => 
        Model.Orders
            .Where(o => o.OrderDate.Year == d.Year && o.OrderDate.Month == d.Month && !string.Equals(o.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            .Sum(o => o.TotalAmount)
    ).ToList();

    var revenueLabelsJson = System.Text.Json.JsonSerializer.Serialize(realMonthLabels);
    var revenueDataJson = System.Text.Json.JsonSerializer.Serialize(realRevenuePoints);
}

<!-- Page Header & Quick Shortcuts -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color: var(--admin-text-main);">Store Overview & Analytics</h1>
        <p class="text-muted small mb-0" style="font-size: 12px;">Real-time performance metrics, order fulfillment, and inventory monitoring.</p>
    </div>

    <!-- Quick Shortcuts -->
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Products" asp-action="Create" class="btn-admin-primary py-1 px-3" style="font-size: 12px;">
            <i class="bi bi-plus-lg"></i> Add Product
        </a>
        <a asp-controller="Categories" asp-action="Create" class="btn-admin-outline py-1 px-3" style="font-size: 12px;">
            <i class="bi bi-folder-plus"></i> New Category
        </a>
    </div>
</div>

<!-- 1. TOP METRIC STAT CARDS (Exact 4 Metrics: Users, Products, Categories, Orders) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Users -->
    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="stat-label">Total Users</span>
                    <div class="stat-value">@totalUsers</div>
                </div>
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="stat-subtext">
                <i class="bi bi-person-check text-success"></i>
                <span>Registered members & customers</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Total Products -->
    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="stat-label">Total Products</span>
                    <div class="stat-value" style="color: var(--admin-primary);">@totalProducts</div>
                </div>
                <div class="stat-icon-wrapper stat-icon-teal">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>
            <div class="stat-subtext">
                <i class="bi bi-check-circle text-success"></i>
                <span>Active catalog equipment</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Total Categories -->
    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="stat-label">Total Categories</span>
                    <div class="stat-value">@Model.Categories.Count</div>
                </div>
                <div class="stat-icon-wrapper stat-icon-primary">
                    <i class="bi bi-tags-fill"></i>
                </div>
            </div>
            <div class="stat-subtext">
                <i class="bi bi-grid text-primary"></i>
                <span>Store department sections</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Total Orders -->
    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="stat-label">Total Orders</span>
                    <div class="stat-value">@totalOrders</div>
                </div>
                <div class="stat-icon-wrapper stat-icon-forest">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
            </div>
            <div class="stat-subtext">
                @if (processingOrders > 0)
                {
                    <span class="badge bg-warning text-dark px-1.5 py-0.5" style="font-size: 10px;">@processingOrders Processing</span>
                }
                else
                {
                    <span class="text-success small fw-semibold">All fulfilled</span>
                }
                <span class="ms-1">($@totalRevenue.ToString("N2") Revenue)</span>
            </div>
        </div>
    </div>
</div>

<!-- 2. CHARTS ROW (Revenue Area Chart & Category Doughnut Chart) -->
<div class="row g-3 mb-4">
    <!-- Revenue Trend Chart -->
    <div class="col-lg-8">
        <div class="admin-card h-100">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13.5px;">
                    <i class="bi bi-graph-up text-primary"></i>
                    <span>Revenue & Sales Growth</span>
                </div>
                <span class="admin-badge admin-badge-teal" style="font-size: 11px;">Monthly Performance</span>
            </div>
            <div class="admin-card-body p-3">
                <div style="height: 240px; position: relative;">
                    <canvas id="revenueChart" 
                            data-labels='@Html.Raw(revenueLabelsJson)' 
                            data-revenue='@Html.Raw(revenueDataJson)'></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Breakdown Doughnut Chart -->
    <div class="col-lg-4">
        <div class="admin-card h-100">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13.5px;">
                    <i class="bi bi-pie-chart text-primary"></i>
                    <span>Category Breakdown</span>
                </div>
                <span class="text-muted small" style="font-size: 11px;">Inventory Mix</span>
            </div>
            <div class="admin-card-body p-3">
                <div style="height: 240px; position: relative;">
                    <canvas id="categoryDoughnutChart" 
                            data-labels='@Html.Raw(categoryLabelsJson)' 
                            data-counts='@Html.Raw(categoryCountsJson)'></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. BOTTOM ROW: RECENT ORDERS & INVENTORY WATCH -->
<div class="row g-3">
    <!-- Left Column: Recent Orders Table -->
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13.5px;">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Recent Customer Orders</span>
                </div>
                <a asp-controller="Orders" asp-action="Index" class="fw-bold text-decoration-none small" style="color: var(--admin-primary); font-size: 12px;">
                    View All Orders <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="admin-table-wrapper">
                <table class="admin-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Order</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th style="width: 70px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentOrders.Any())
                        {
                            @foreach (var order in recentOrders)
                            {
                                var custName = order.User?.FullName ?? order.User?.UserName ?? "Guest";
                                var status = order.Status ?? "Processing";

                                <tr>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="fw-bold text-decoration-none" style="color: var(--admin-primary); font-size: 12.5px;">
                                            #@order.Id
                                        </a>
                                    </td>
                                    <td>
                                        <span class="fw-bold d-block text-truncate" style="color: var(--admin-text-main); font-size: 12px; max-width: 150px;">
                                            @custName
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small" style="font-size: 11px;">
                                            @order.OrderDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold" style="color: var(--admin-primary); font-size: 12.5px;">
                                            $@order.TotalAmount.ToString("F2")
                                        </span>
                                    </td>
                                    <td>
                                        @if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="admin-badge admin-badge-success" style="font-size: 10.5px;">
                                                <i class="bi bi-check2-circle"></i> Completed
                                            </span>
                                        }
                                        else if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="admin-badge admin-badge-danger" style="font-size: 10.5px;">
                                                <i class="bi bi-x-circle"></i> Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-warning" style="font-size: 10.5px;">
                                                <i class="bi bi-arrow-repeat"></i> Processing
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn-action-icon" title="View Order">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-3 text-muted small">
                                    No customer orders placed yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: Low Stock Watch & Management Links -->
    <div class="col-lg-4">
        <!-- Low Stock Inventory Card -->
        <div class="admin-card mb-3">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13px;">
                    <i class="bi bi-exclamation-triangle text-warning"></i>
                    <span>Low Stock Watch</span>
                </div>
                <span class="admin-badge admin-badge-danger" style="font-size: 10px;">&le; 10 Units</span>
            </div>
            <div class="admin-card-body p-2">
                @if (lowStockProducts.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var prod in lowStockProducts)
                        {
                            var img = prod.ProductImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                      ?? prod.ProductImages?.FirstOrDefault()?.ImageUrl;

                            <div class="list-group-item px-2 py-2 border-0 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2 overflow-hidden">
                                    <div class="rounded border bg-light d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0" style="width: 32px; height: 32px;">
                                        @if (!string.IsNullOrEmpty(img))
                                        {
                                            <img src="@img" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-box text-muted small"></i>
                                        }
                                    </div>
                                    <div class="overflow-hidden">
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@prod.Id" class="fw-bold text-decoration-none text-truncate d-block small" style="color: var(--admin-text-main); font-size: 11.5px;">
                                            @prod.Name
                                        </a>
                                        <span class="text-muted" style="font-size: 10.5px;">$@prod.Price.ToString("F2")</span>
                                    </div>
                                </div>
                                <span class="badge @(prod.Stock == 0 ? "bg-danger" : "bg-warning text-dark") px-2 py-1 flex-shrink-0" style="font-size: 10.5px;">
                                    @(prod.Stock == 0 ? "Out of Stock" : $"{prod.Stock} Left")
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small">
                        <i class="bi bi-check-circle text-success fs-4 d-block mb-1"></i>
                        All inventory items are well-stocked!
                    </div>
                }
            </div>
        </div>

        <!-- Quick Administration Shortcuts -->
        <div class="admin-card">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13px;">
                    <i class="bi bi-lightning text-primary"></i>
                    <span>Quick Navigation</span>
                </div>
            </div>
            <div class="p-2 d-grid gap-2">
                <a asp-controller="Categories" asp-action="Index" class="btn btn-light text-start d-flex align-items-center justify-content-between py-1.5 px-2 border" style="font-size: 12px;">
                    <span><i class="bi bi-tags me-2 text-primary"></i> Manage Categories</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a asp-controller="Reviews" asp-action="Index" class="btn btn-light text-start d-flex align-items-center justify-content-between py-1.5 px-2 border" style="font-size: 12px;">
                    <span><i class="bi bi-chat-quote me-2 text-primary"></i> Review & Moderation</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a asp-controller="Users" asp-action="Index" class="btn btn-light text-start d-flex align-items-center justify-content-between py-1.5 px-2 border" style="font-size: 12px;">
                    <span><i class="bi bi-people me-2 text-primary"></i> Customer Directory</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Engine from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Barrameru Dashboard Charts JS -->
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
}
