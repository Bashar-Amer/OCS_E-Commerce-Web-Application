@model CampTravelGear.Models.Product

@{
    ViewData["Title"] = "Add Product";
    var categories = ViewBag.categories as List<CampTravelGear.Models.Category> ?? new List<CampTravelGear.Models.Category>();
}

<div class="mb-3">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-action="Index" class="btn-admin-outline py-1 px-2" style="font-size: 11.5px;">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
    </div>
    <h1 class="h4 fw-bold mb-1" style="color: var(--admin-text-main);">Add New Product</h1>
    <p class="text-muted small mb-0" style="font-size: 12px;">Create a new item in the outdoor gear store catalog.</p>
</div>

<div class="row g-3">
    <!-- Main Form Column -->
    <div class="col-lg-8 col-xl-7">
        <div class="admin-card">
            <div class="admin-card-header py-2 px-3">
                <div class="admin-card-title" style="font-size: 13.5px;">
                    <i class="bi bi-box-seam text-primary"></i>
                    <span>Product Information</span>
                </div>
            </div>

            <div class="admin-card-body p-3">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- Hidden Selected Main Image Index -->
                    <input type="hidden" name="main" id="selectedNewImageIndexInput" value="0" />

                    <!-- Validation Summary -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger rounded-0 small py-1 px-2 mb-2" role="alert"></div>
                    }

                    <!-- Product Name -->
                    <div class="admin-form-group mb-3">
                        <label asp-for="Name" class="admin-form-label">
                            Product Title <span class="text-danger">*</span>
                        </label>
                        <div class="admin-input-group">
                            <div class="input-icon-box">
                                <i class="bi bi-tag-fill"></i>
                            </div>
                            <input asp-for="Name" class="admin-form-control" placeholder="e.g. 4-Person Expedition Dome Tent" autocomplete="off" autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                    </div>

                    <!-- Category Assignment -->
                    <div class="admin-form-group mb-3">
                        <label asp-for="CategoryId" class="admin-form-label">
                            Category <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CategoryId" class="admin-form-control" style="cursor: pointer;">
                            <option value="">-- Select a Category --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                    </div>

                    <!-- Price & Stock (Row) -->
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Price" class="admin-form-label">
                                Price ($ USD) <span class="text-danger">*</span>
                            </label>
                            <div class="admin-input-group">
                                <div class="input-icon-box">
                                    <i class="bi bi-currency-dollar"></i>
                                </div>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="admin-form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="Stock" class="admin-form-label">
                                Initial Stock Quantity <span class="text-danger">*</span>
                            </label>
                            <div class="admin-input-group">
                                <div class="input-icon-box">
                                    <i class="bi bi-stack"></i>
                                </div>
                                <input asp-for="Stock" type="number" min="0" class="admin-form-control" placeholder="0" />
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                        </div>
                    </div>

                    <!-- Multiple Image Upload Box with Main Selection -->
                    <div class="admin-form-group mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="admin-form-label mb-0">
                                Product Images <span class="text-muted fw-normal">(PNG, JPG, WEBP)</span>
                            </label>
                            <span class="text-muted small" style="font-size: 11px;">
                                <i class="bi bi-info-circle text-primary"></i> Click any image to set as Cover
                            </span>
                        </div>

                        <div class="admin-file-dropzone" id="imageDropzone">
                            <input type="file" name="imageFiles" id="productImageFilesInput" class="d-none" multiple accept="image/png, image/jpeg, image/webp, image/gif" />
                            <div class="text-center py-3 px-2" style="cursor: pointer;" onclick="document.getElementById('productImageFilesInput').click()">
                                <i class="bi bi-cloud-arrow-up fs-3 text-primary d-block mb-1"></i>
                                <span class="fw-semibold small d-block text-dark">Click to browse or drag & drop images</span>
                                <span class="text-muted small" style="font-size: 11px;">Select multiple product photos</span>
                            </div>
                        </div>

                        <!-- Live Image Preview Grid (Click thumbnail to choose Cover) -->
                        <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-2" style="display: none !important;"></div>
                    </div>

                    <!-- Description -->
                    <div class="admin-form-group mb-3">
                        <label asp-for="Description" class="admin-form-label">Product Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide features, materials, weather rating, specifications..." style="font-size: 13px; border: 1.5px solid var(--admin-border-color); border-radius: var(--admin-radius);"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block" style="font-size: 11.5px;"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center gap-2 pt-2 border-top mt-3">
                        <button type="submit" class="btn-admin-primary">
                            <i class="bi bi-check2-circle"></i> Save Product
                        </button>
                        <a asp-action="Index" class="btn-admin-outline">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Helpful Guidance Column -->
    <div class="col-lg-4 col-xl-5">
        <div class="admin-card border-0" style="background-color: #F0FDFA; border: 1.5px dashed var(--admin-accent-teal) !important;">
            <div class="admin-card-body p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-lightbulb-fill text-primary fs-6"></i>
                    <span class="fw-bold" style="color: var(--admin-text-main); font-size: 12.5px;">Product Guidelines</span>
                </div>
                <ul class="list-unstyled small text-secondary mb-0" style="font-size: 11.5px;">
                    <li class="mb-1 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <span><strong>Title</strong>: Include key attributes (brand, capacity, model).</span>
                    </li>
                    <li class="mb-1 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <span><strong>Pricing</strong>: Set standard selling price in USD.</span>
                    </li>
                    <li class="mb-1 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <span><strong>Stock Level</strong>: Low inventory alerts trigger when stock is $\le 10$.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-image text-primary mt-1"></i>
                        <span><strong>Cover Photo</strong>: Click any uploaded thumbnail to set it as the primary cover photo.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin/products.js" asp-append-version="true"></script>
}
