<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rahhala Admin Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Admin Design System CSS -->
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Left Sidebar -->
        <partial name="_AdminSidebar" />

        <!-- Mobile Sidebar Backdrop Overlay -->
        <div class="admin-sidebar-backdrop"></div>

        <!-- Main Content Area -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <button type="button" class="admin-sidebar-toggle" title="Toggle Sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb admin-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid-1x2-fill me-1 small"></i>Admin
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>

                <div class="admin-topbar-right">
                    <!-- Quick Storefront Link -->
                    <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="admin-storefront-btn" title="Open Storefront in New Tab">
                        <i class="bi bi-shop"></i>
                        <span>View Store</span>
                        <i class="bi bi-box-arrow-up-right small ms-1"></i>
                    </a>
                </div>
            </header>

            <!-- Page Content Body -->
            <main class="admin-content">
                <!-- TempData Flash Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-0 border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-0 border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin/admin-layout.js" asp-append-version="true"></script>

    <!-- Global SweetAlert2 Toast Renderer -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
            {
                var msg = TempData["Success"] ?? TempData["SuccessMessage"];
                <text>
                if (window.showAdminToast) {
                    window.showAdminToast('@Html.Raw(msg)', 'success');
                }
                </text>
            }
            @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
            {
                var msg = TempData["Error"] ?? TempData["ErrorMessage"];
                <text>
                if (window.showAdminToast) {
                    window.showAdminToast('@Html.Raw(msg)', 'error');
                }
                </text>
            }
            @if (TempData["Warning"] != null || TempData["WarningMessage"] != null)
            {
                var msg = TempData["Warning"] ?? TempData["WarningMessage"];
                <text>
                if (window.showAdminToast) {
                    window.showAdminToast('@Html.Raw(msg)', 'warning');
                }
                </text>
            }
            @if (TempData["Info"] != null || TempData["InfoMessage"] != null)
            {
                var msg = TempData["Info"] ?? TempData["InfoMessage"];
                <text>
                if (window.showAdminToast) {
                    window.showAdminToast('@Html.Raw(msg)', 'info');
                }
                </text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
