@using CampTravelGear.Helpers
@model IPaginatedList

@{
    if (Model == null || Model.TotalCount == 0)
    {
        return;
    }

    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";

    var pageParam = ViewData["PageParamName"]?.ToString() ?? "page";
    var fragment = ViewData["Fragment"]?.ToString() ?? "";

    // Retain current query parameters except current pageParam
    var routeData = new Dictionary<string, string>();
    foreach (var key in Context.Request.Query.Keys)
    {
        if (!string.IsNullOrEmpty(key) && key.ToLower() != pageParam.ToLower())
        {
            routeData[key] = Context.Request.Query[key].ToString();
        }
    }

    string GetPageUrl(int pageNumber)
    {
        var queryParams = new Dictionary<string, string>(routeData);
        queryParams[pageParam] = pageNumber.ToString();
        var queryString = string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value)}"));
        return $"{Context.Request.Path}?{queryString}{fragment}";
    }
}

<div class="admin-table-footer">
    <div class="admin-table-info">
        Showing <strong>@Model.StartItemIndex</strong> to <strong>@Model.EndItemIndex</strong> of <strong>@Model.TotalCount</strong> entries
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Table navigation">
            <ul class="admin-pagination">
                <!-- Previous Button -->
                <li class="page-item @prevDisabled">
                    <a class="page-link" href="@(Model.HasPreviousPage ? GetPageUrl(Model.PageIndex - 1) : "#")" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                <!-- Max 3 Sliding Page Numbers -->
                @{
                    int startPage, endPage;
                    if (Model.TotalPages <= 3)
                    {
                        startPage = 1;
                        endPage = Model.TotalPages;
                    }
                    else if (Model.PageIndex <= 1)
                    {
                        startPage = 1;
                        endPage = 3;
                    }
                    else if (Model.PageIndex >= Model.TotalPages)
                    {
                        startPage = Model.TotalPages - 2;
                        endPage = Model.TotalPages;
                    }
                    else
                    {
                        startPage = Model.PageIndex - 1;
                        endPage = Model.PageIndex + 1;
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        var activeClass = i == Model.PageIndex ? "active" : "";
                        <li class="page-item @activeClass">
                            <a class="page-link" href="@GetPageUrl(i)">@i</a>
                        </li>
                    }
                }

                <!-- Next Button -->
                <li class="page-item @nextDisabled">
                    <a class="page-link" href="@(Model.HasNextPage ? GetPageUrl(Model.PageIndex + 1) : "#")" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
