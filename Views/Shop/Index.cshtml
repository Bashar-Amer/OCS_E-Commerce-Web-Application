@model List<CampTravelGear.Models.ViewModels.ShopProductViewModel>
@{
    ViewData["Title"] = "Shop Products";
    var categories = (List<(string Name, int Count)>)ViewBag.Categories;
    var selectedCategory = (string?)ViewBag.SelectedCategory;
    var selectedSort = (string)ViewBag.SelectedSort;
}
<form id="globalAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>
@section Styles {
    <link rel="stylesheet" href="~/css/pages/shop.css" asp-append-version="true" />
}

<!-- Inner Page Hero Banner -->
<section class="inner-hero-banner" style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">
    <div class="inner-hero-overlay"></div>
    <div class="container position-relative">
        <div class="inner-hero-content">
            <div class="breadcrumbs">HOME / SHOP</div>
            <h1>SHOP</h1>
            <div class="sub-text">Products</div>
        </div>
    </div>
</section>

<!-- Main Shop Grid & Sidebar -->
<section class="py-5 bg-white">
    <div class="container">
        <form asp-controller="Shop" asp-action="Index" method="get" id="shopFilterForm">
            <div class="row g-4">
                <!-- Left Sidebar -->
                <div class="col-lg-3 shop-sidebar">
                    <div class="mb-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="search" id="shopSearchInput"
                                   class="form-control border-start-0 rounded-0"
                                   placeholder="Search gear..." value="@ViewBag.SearchQuery" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold mb-3">Categories</h5>
                        <ul class="list-unstyled">
                            <li class="py-1">
                                <div class="form-check">
                                    <input class="form-check-input shop-cat-filter" type="radio" name="category"
                                           id="cat-all" value="all"
                                    @(string.IsNullOrEmpty(selectedCategory) || selectedCategory == "all" ? "checked" : "") />
                                    <label class="form-check-label small text-dark" for="cat-all">
                                        All Equipment
                                    </label>
                                </div>
                            </li>
                            @foreach (var cat in categories)
                            {
                                var catId = "cat-" + cat.Name.Replace(" ", "-").ToLower();
                                <li class="py-1">
                                    <div class="form-check d-flex justify-content-between align-items-center">
                                        <div>
                                            <input class="form-check-input shop-cat-filter" type="radio" name="category"
                                                   id="@catId" value="@cat.Name"
                                            @(selectedCategory == cat.Name ? "checked" : "") />
                                            <label class="form-check-label small text-dark" for="@catId">
                                                @cat.Name
                                            </label>
                                        </div>
                                        <span class="text-muted small">(@cat.Count)</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Right Products Grid -->
                <div class="col-lg-9">

                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

                        <!-- Results Count -->
                        <span class="text-muted small">
                            Showing @ViewBag.PageStart–@ViewBag.PageEnd of @ViewBag.TotalResults results
                        </span>

                        <!-- Sorting -->
                        <div class="shop-sort">

                            <label for="shopSortingSelect" class="shop-sort-label">
                                Sort by
                            </label>

                            <select name="sort"
                                    id="shopSortingSelect"
                                    class="shop-sorting-select"
                                    onchange="document.getElementById('shopFilterForm').submit()">

                                <option value="default" selected="@(selectedSort == "default")">
                                    Default sorting
                                </option>

                                <option value="price-asc" selected="@(selectedSort == "price-asc")">
                                    Price: Low to High
                                </option>

                                <option value="price-desc" selected="@(selectedSort == "price-desc")">
                                    Price: High to Low
                                </option>

                                <option value="rating" selected="@(selectedSort == "rating")">
                                    Average Rating
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- Products -->
                    <div class="row g-4">

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var p in Model)
                            {
                                <div class="col-6 col-md-6 col-lg-4">

                                    <div class="template-product-card">

                                        <!-- Product Image -->
                                        <div class="position-relative">

                                            <a href="/Shop/Details/@p.Id">

                                                <img src="@(p.ImageUrl ?? "/images/placeholder.png")"
                                                     alt="@p.Name"
                                                     class="template-product-img"
                                                     loading="lazy">

                                            </a>


                                            <!-- Wishlist -->
                                            <button type="button"
                                                    class="template-wishlist-btn"
                                                    data-product-id="@p.Id"
                                                    onclick="BarrameruStore.toggleWishlist(@p.Id, { name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', price: @p.Price, image: '@(p.ImageUrl ?? "/images/placeholder.png")' }, this)"
                                                    aria-label="Add to wishlist">

                                                <i class="bi bi-heart"></i>

                                            </button>

                                        </div>


                                        <!-- Product Info -->
                                        <div>

                                            <!-- Product Name -->
                                            <h6 class="template-product-title">

                                                <a href="/Shop/Details/@p.Id">
                                                    @p.Name
                                                </a>

                                            </h6>


                                            <!-- Rating -->
                                            <div class="template-product-rating">

                                                @if (p.ReviewCount > 0)
                                                {
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="bi @(i <= Math.Round(p.AverageRating)
                                                                                                                                                                                                                                                                                                        ? "bi-star-fill"
                                                                                                                                                                                                                                                                                                        : "bi-star")"></i>
                                                }

                                                <span class="text-muted ms-1">
                                                    (@p.ReviewCount)
                                                </span>
                                            }
                                                else
                                            {
                                                <span class="text-muted">
                                                    No reviews yet
                                                </span>
                                            }

                                        </div>


                                        <!-- Price -->
                                        <div class="template-product-price">
                                            @p.Price.ToString("C")
                                        </div>

                                    </div>


                                    <!-- Add To Cart -->
                                    <button type="button"
                                            class="btn btn-template-add-cart"
                                            onclick="BarrameruStore.addToCart(@p.Id, 1, {name:'@p.Name',price:'@p.Price',image:'@p.ImageUrl'})">

                                        <i class="bi bi-cart3 me-1"></i>
                                        Add to cart

                                    </button>

                                </div>

                            </div>
                        }
                    }
        else
                    {
                        <div class="col-12 text-center py-5">

                            <p class="text-muted mb-0">
                                No products found.
                            </p>

                        </div>
                    }

                </div>

                
                <!-- Pagination -->
                @{
                    int currentPage = (int)ViewBag.CurrentPage;
                    int totalPages = (int)ViewBag.TotalPages;
                }

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-center gap-2 mt-5 flex-wrap">

                        @for (int p = 1; p <= totalPages; p++)
                        {
                            if (p == currentPage)
                            {
                                <span class="btn btn-sm btn-dark rounded-0 px-3">
                                    @p
                                </span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new
                                   {
                                       category = selectedCategory,
                                       search = ViewBag.SearchQuery,
                                       sort = selectedSort,
                                       page = p
                                   })"
                                   class="btn btn-sm btn-outline-secondary rounded-0 px-3">

                                    @p

                                </a>
                            }
                        }

                    </div>
                }

            </div>

        </div>
    </form>
</div>
</section>

@section Scripts {
    <script>
        // submit تلقائي عند اختيار كاتيجوري
        document.querySelectorAll('.shop-cat-filter').forEach(function(el) {
            el.addEventListener('change', function() {
                document.getElementById('shopFilterForm').submit();
            });
        });
    </script>
}