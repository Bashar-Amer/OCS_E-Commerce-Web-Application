
@model CampTravelGear.Models.Product

@{
    ViewData["Title"] = Model.Name;

    // Main Product Image
    var mainImage = Model.ProductImages
        .FirstOrDefault(x => x.IsMain)?.ImageUrl
        ?? Model.ProductImages.FirstOrDefault()?.ImageUrl
        ?? "/images/placeholder.jpg";

    // Ratings
    var ratings = Model.Reviews
        .Where(r => r.Rating.HasValue && r.Status == "Accepted")
        .Select(r => r.Rating!.Value)
        .ToList();

    var averageRating = ratings.Any()
        ? Math.Round(ratings.Average(), 1)
        : 0;

    var reviewCount = ratings.Count;
}
<form id="globalAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/product-details.css"
          asp-append-version="true" />
}


<!-- =========================================================
     HERO BANNER
========================================================= -->

<section class="inner-hero-banner"
         style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">

    <div class="inner-hero-overlay"></div>

    <div class="container position-relative">

        <div class="inner-hero-content">

            <div class="breadcrumbs">
                HOME / SHOP 
            </div>

            <h1>
                @Model.Name
            </h1>

            <div class="sub-text">
                @Model.Category?.Name
            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     PRODUCT DETAILS
========================================================= -->

<section class="py-5 bg-white">

    <div class="container py-4">
        <div class="row g-5 align-items-stretch">

    <!-- =================================================
         LEFT COLUMN - PRODUCT INFORMATION
    ================================================== -->

    <div class="col-lg-6 d-flex">

    <div class="w-100 d-flex flex-column h-100">
<div class="d-flex flex-column h-100 m-4">
    <!-- Product Name -->

            <h1 class="fw-bold mb-2 text-dark"
                style="font-size: 2.3rem;">

                @Model.Name

            </h1>



            <!-- Rating -->

            <div class="d-flex align-items-center gap-2 mb-3">

                <div class="template-product-rating">

                    @if (reviewCount > 0)
                    {
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Math.Round(averageRating)
                                ? "bi-star-fill"
                                : "bi-star")"></i>
                        }

                        <span class="text-muted small ms-1">
                            (@reviewCount)
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">
                            No reviews yet
                        </span>
                    }

                </div>

            </div>


            <!-- Description -->
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="text-muted small mb-4" style="white-space: pre-line; line-height: 1.75; color: #4b5563 !important;">
                    @Model.Description
                </div>
            }
            else
            {
                <p class="text-muted small mb-4">
                    No description available for this product.
                </p>
            }

            <!-- Price -->
            <div class="fs-4 fw-bold mb-4" style="color: #5E959F;">
                <span class="me-2">
                    Price:
                </span>
                <span>
                    @Model.Price.ToString("C")
                </span>
            </div>


            <!-- ADD TO CART / WISHLIST -->
            @if (Model.Stock > 0)
            {
                <div class="d-flex align-items-center gap-2 mt-auto flex-wrap pt-2">
                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width: 220px;">
                        <input type="number"
                               id="detailQtyInput"
                               class="form-control rounded-0 text-center"
                               value="1"
                               min="1"
                               max="@Model.Stock"
                               style="width: 65px; height: 44px;">

                        <button type="button"
                                class="btn btn-barrameru flex-grow-1"
                                style="height: 44px;"
                                onclick="BarrameruStore.addToCart(
                                    @Model.Id,
                                    parseInt(document.getElementById('detailQtyInput').value)
                                )">
                            <i class="bi bi-cart3 me-1"></i>
                            ADD TO CART
                        </button>
                    </div>

                    <button type="button"
                            class="btn btn-outline-secondary rounded-0 px-3 small fw-bold text-decoration-none btn-wishlist-toggle d-inline-flex align-items-center justify-content-center"
                            style="height: 44px;"
                            data-product-id="@Model.Id"
                            onclick="BarrameruStore.toggleWishlist(@Model.Id, { name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Name))', price: @Model.Price, image: '@mainImage' }, this)">
                        <i class="bi bi-heart me-1"></i>
                        <span>Wishlist</span>
                    </button>
                </div>
            }
            else
            {
                <div class="mb-4">

                    <button type="button"
                            class="btn btn-secondary rounded-0"
                            disabled>

                        OUT OF STOCK

                    </button>

                </div>
            }
            </div>

            <!-- PRODUCT META -->
            <div class="small text-muted border-top pt-3 mt-auto pb-2">
                <div class="mb-1 d-flex align-items-center gap-1">
                    <strong>Stock:</strong>
                    @if (Model.Stock > 0)
                    {
                        <span class="text-success fw-semibold">In Stock (@Model.Stock)</span>
                    }
                    else
                    {
                        <span class="text-danger fw-semibold">Out of Stock</span>
                    }
                </div>

                <div class="mb-1 d-flex align-items-center gap-1">
                    <strong>Category:</strong>
                    <span>@(Model.Category?.Name ?? "Uncategorized")</span>
                </div>
            </div>

        </div>

    </div>


    <!-- =================================================
         RIGHT COLUMN - PRODUCT GALLERY
    ================================================== -->

    <div class="col-lg-6 d-flex">

        <div class="w-100">

            <!-- Main Image -->

            <div class="border p-3 text-center position-relative mb-3 bg-white" style="border-radius: 4px;">
                <img id="mainDetailImg"
                     src="@mainImage"
                     alt="@Model.Name"
                     class="img-fluid product-detail-main-image"
                     onclick="openProductImage()"
                     style="cursor: zoom-in; max-height: 380px; width: 100%; object-fit: contain;">
            </div>


            <!-- Thumbnails -->

            @if (Model.ProductImages.Any())
            {
                <div class="row g-2">

                    @foreach (var image in Model.ProductImages)
                    {
                        <div class="col-3">
                            <img src="@image.ImageUrl"
     data-image="@image.ImageUrl"
     alt="@Model.Name"
     class="img-fluid border p-1 detail-thumb @(image.ImageUrl == mainImage ? "detail-thumb-active" : "")"
     onclick="changeMainImage(this)"
     style="
        height: 80px;
        width: 100%;
        object-fit: contain;
        cursor: pointer;
     ">

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

       
        <!--  REVIEWS ============================ -->

<div class="mt-5 pt-5 border-top">

    <div class="row g-5">

        <!-- Reviews -->
        <div class="col-lg-7">

            <div class="d-flex align-items-center justify-content-between mb-4">

                <div>
                    <span class="sub-badge text-teal">
                        Reviews
                    </span>

                    <h4 class="fw-bold mb-0 mt-2">
                        Customer Reviews
                    </h4>
                </div>

                <div class="text-end">

                    <div class="text-warning small">

                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Math.Round(averageRating)
                                ? "bi-star-fill"
                                : "bi-star")"></i>
                        }

                    </div>

                    <small class="text-muted">
                        @averageRating.ToString("0.0")
                        · @reviewCount reviews
                    </small>

                </div>

            </div>


            <!-- Reviews List -->

           @if (Model.Reviews.Any(r => r.Rating.HasValue && r.Status == "Accepted"))
           {
                foreach (var review in Model.Reviews
                    .Where(r => r.Rating.HasValue && r.Status == "Accepted")
                    .OrderByDescending(r => r.CreatedAt))
                {
                    <div class="py-3 border-bottom">

                        <div class="d-flex justify-content-between mb-1">

                            <strong class="small">
                                @(review.User?.UserName ?? "Customer")
                            </strong>

                            <small class="text-muted">
                                @review.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                            </small>

                        </div>

                        <div class="text-warning small mb-2">

                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating!.Value
                                    ? "bi-star-fill"
                                    : "bi-star")"></i>
                            }

                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="text-muted small mb-0">
                                @review.Comment
                            </p>
                        }

                    </div>
                }
            }
            else
            {
                <p class="text-muted small mb-0">
                    No reviews yet. Be the first to review this product.
                </p>
            }

        </div>


        <!-- Write Review -->

        <div class="col-lg-5">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="review-form">

                    <h5 class="fw-bold mb-1">
                        Write a Review
                    </h5>

                    <p class="text-muted small mb-3">
                        Share your experience with this product.
                    </p>


                    <!-- Rating -->

                    <label class="small fw-semibold mb-2">
                        Your Rating
                    </label>

<div class="review-stars mb-3" id="reviewStarsContainer">

    @for (int i = 1; i <= 5; i++)
    {
        <input type="radio"
               name="rating"
               id="rating-@i"
               value="@i"
               class="d-none"
               onchange="updateStarDisplay(@i)" />

        <label for="rating-@i"
               class="review-star"
               data-star="@i">

            <i class="bi bi-star"></i>

        </label>
    }

</div>

                


                    <!-- Comment -->

                    <textarea id="reviewCommentInput"
          name="comment"
          class="form-control rounded-0 mb-3"
          rows="4"
          maxlength="1000"
          placeholder="Write your comment..."></textarea>


                    <button type="button"
        id="submitReviewBtn"
        class="btn btn-template-add-cart"
        onclick="submitProductReview(@Model.Id)">

    <i class="bi bi-send me-1"></i>
    Submit Review

</button>

                </div>
            }
            else
            {
                <div class="review-login">

                    <h5 class="fw-bold mb-2">
                        Have something to say?
                    </h5>

                    <p class="text-muted small mb-3">
                        Login to leave a rating and review.
                    </p>

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="@Context.Request.Path"
                       class="btn btn-template-add-cart">

                        Login to Review

                    </a>

                </div>
            }

        </div>

    </div>

</div>
       
        <!-- ===========  RELATED PRODUCTS  ==================== -->

        <div class="mt-5 pt-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h3 class="fw-bold mb-0">
                    Related Products
                </h3>

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="btn btn-barrameru btn-sm">

                    ALL PRODUCTS

                </a>

            </div>


            @{
                var relatedProducts = Model.Category?.Products?
                    .Where(p =>
                        p.Id != Model.Id &&
                        p.IsActive &&
                        !p.IsDeleted)
                    .Take(4)
                    .ToList();
            }


            @if (relatedProducts != null && relatedProducts.Any())
            {
                <div class="row g-4">

                    @foreach (var product in relatedProducts)
                    {
                        var relatedImage = product.ProductImages
                            .FirstOrDefault(x => x.IsMain)?.ImageUrl
                            ?? product.ProductImages.FirstOrDefault()?.ImageUrl
                            ?? "/images/placeholder.jpg";

                        var productRatings = product.Reviews
                            .Where(r => r.Rating.HasValue)
                            .Select(r => r.Rating!.Value)
                            .ToList();

                        var productAverageRating = productRatings.Any()
                            ? Math.Round(productRatings.Average(), 1)
                            : 0;

                        var productReviewCount = productRatings.Count;


                        <div class="col-lg-3 col-md-6">

                            <div class="template-product-card">


                                <!-- Product Image -->

                                <div class="position-relative">

                                    <a href="/Shop/Details/@product.Id">

                                        <img src="@relatedImage"
                                             alt="@product.Name"
                                             class="template-product-img"
                                             loading="lazy">

                                    </a>


                                    <!-- Wishlist -->
                                                                       <button type="button"
                                        class="template-wishlist-btn" data-product-id="@product.Id"
                                        onclick="BarrameruStore.toggleWishlist(@product.Id, { name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(product.Name))', price: @product.Price, image: '@relatedImage' }, this)"
                                        aria-label="Add to wishlist">

                                    <i class="bi bi-heart"></i>

                                </button>

                                </div>


                                <!-- Product Info -->

                                <div>

                                    <h6 class="template-product-title">

                                        <a href="/Shop/Details/@product.Id">

                                            @product.Name

                                        </a>

                                    </h6>


                                    <!-- Rating -->

                                    <div class="template-product-rating">

                                        @if (productReviewCount > 0)
                                        {
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= Math.Round(productAverageRating)
                                                    ? "bi-star-fill"
                                                    : "bi-star")"></i>
                                            }

                                            <span class="text-muted ms-1">
                                                (@productReviewCount)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No reviews yet
                                            </span>
                                        }

                                    </div>


                                    <!-- Price -->

                                    <div class="template-product-price">

                                        @product.Price.ToString("C")

                                    </div>

                                </div>


                                <!-- Add To Cart -->

                                <button type="button"
                                        class="btn btn-template-add-cart"
                                        onclick="BarrameruStore.addToCart(@product.Id, 1)">

                                    <i class="bi bi-cart3 me-1"></i>

                                    Add to cart

                                </button>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <p class="text-muted">
                    No related products found.
                </p>
            }

        </div>

    </div>

</section>


<!-- ==== IMAGE MODAL=================== -->

<div class="modal fade"
     id="productImageModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 rounded-0">

            <div class="modal-body p-0 position-relative">

                <button type="button"
                        class="btn-close position-absolute top-0 end-0 m-3"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

                <img id="modalProductImage"
                     src="@mainImage"
                     alt="@Model.Name"
                     class="img-fluid w-100"
                     style="max-height: 80vh; object-fit: contain;">

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/pages/product-details.js"
            asp-append-version="true"></script>

    <script>

        


        function openProductImage() {

            const mainImage =
                document.getElementById("mainDetailImg");

            const modalImage =
                document.getElementById("modalProductImage");

            if (!mainImage || !modalImage) return;

            modalImage.src = mainImage.src;

            const modalElement =
                document.getElementById("productImageModal");

            const modal =
                new bootstrap.Modal(modalElement);

            modal.show();
        }

function updateStarDisplay(selectedRating) {
    document.querySelectorAll('#reviewStarsContainer .review-star').forEach(label => {
        const starValue = parseInt(label.getAttribute('data-star'));
        const icon = label.querySelector('i');

        if (starValue <= selectedRating) {
            icon.className = 'bi bi-star-fill text-warning';
        } else {
            icon.className = 'bi bi-star';
        }
    });
}
async function submitProductReview(productId) {

    const selectedRating = document.querySelector('input[name="rating"]:checked');
    const comment = document.getElementById('reviewCommentInput')?.value.trim();
    const btn = document.getElementById('submitReviewBtn');

    if (!selectedRating) {
        alert('Please select a rating before submitting.');
        return;
    }

    const token = document.querySelector(
        '#globalAntiForgeryForm input[name="__RequestVerificationToken"]'
    )?.value;

    btn.disabled = true;

    try {
        const res = await fetch('/Shop/AddReview', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
                productId: productId,
                rating: selectedRating.value,
                comment: comment || '',
                __RequestVerificationToken: token
            })
        });

        if (res.status === 401) {
            window.location.href = '/Account/Login';
            return;
        }

        const data = await res.json();

        if (data.success) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'Review submitted!',
                    text: data.message,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                alert(data.message);
            }

            setTimeout(() => window.location.reload(), 1200);
        } else {
            alert(data.message || 'Something went wrong.');
            btn.disabled = false;
        }

    } catch (e) {
        console.error(e);
        alert('Something went wrong. Please try again.');
        btn.disabled = false;
    }
}
    </script>

}

