<!-- Section 4: Testimonials -->
<section style="background-image: url('/images/tourist-sitting-phu-sub-lek-viewpoint-sunset-lopburi-thailand-e1664089245105.jpg'); background-size: cover; background-position: center; min-height: 440px; display: flex; align-items: center; position: relative;">
    <div style="position: absolute; inset: 0; background: rgba(21, 42, 41, 0.85);"></div>
    <div class="container position-relative" style="z-index: 2;">
        <div class="row">
            <div class="col-lg-6 text-white border p-4 p-md-5" style="border-color: rgba(255,255,255,0.2) !important;">
                <span class="sub-badge text-white">Testimonials</span>
                <h2 class="text-white fw-bold mb-3">What They Say</h2>
                <p class="fst-italic text-white-50 mb-4" style="font-size: 15px;">
                    "We've seen amazing results already. I wish I would have thought of it first. Barrameru should be nominated for service of the year. Great Job!"
                </p>
                <div class="fw-bold text-white small">Sara G. Helvey</div>
