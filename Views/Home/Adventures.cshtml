@{
    ViewData["Title"] = "Activity & Adventures";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/adventures.css" asp-append-version="true" />
}

<!-- Hero Banner (Matches adventures.jpg) -->
<section class="inner-hero-banner" style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">
    <div class="inner-hero-overlay"></div>
    <div class="container position-relative">
        <div class="inner-hero-content">
            <div class="breadcrumbs">HOME / ADVENTURES</div>
            <h1>Activity & Adventures</h1>
            <div class="sub-text">Get your backpack ready!</div>
        </div>
    </div>
</section>

<!-- Section 1: Explore Activities (6 photos 3x2) -->
<section class="py-5 bg-white text-center">
    <div class="container py-4">
        <span class="sub-badge text-teal">Select Your Activity</span>
        <h2 class="fw-bold mb-5">Explore Activities</h2>

        <div class="row g-4 mb-4">
            <div class="col-md-6 activity-grid-item">
                <img src="~/images/spending-time-by-the-campfire.jpg" alt="Campfire" class="img-fluid w-100">
            </div>
            <div class="col-md-6 activity-grid-item">
                <img src="~/images/paddling-kayaker-on-the-scenic-lake.jpg" alt="Kayaker" class="img-fluid w-100">
            </div>
            <div class="col-md-6 activity-grid-item">
                <img src="~/images/group-of-mountain-bikers-riding-on-road-outdoors-in-winter-.jpg" alt="Mountain Bikers" class="img-fluid w-100">
            </div>
            <div class="col-md-6 activity-grid-item">
                <img src="~/images/happy-couple-sitting-on-paddleboards-at-lake.jpg" alt="Paddleboards" class="img-fluid w-100">
            </div>
            <div class="col-md-6 activity-grid-item">
                <img src="~/images/group-of-friends-with-backpacks-doing-trekking-excursion-on-mountain.jpg" alt="Trekking" class="img-fluid w-100">
            </div>
            <div class="col-md-6 activity-grid-item">
                <img src="~/images/happy-asian-young-travellers-with-4wd-drive-car-off-road-in-forest--e1664201038495.jpg" alt="4WD Offroad" class="img-fluid w-100">
            </div>
        </div>

        <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru">EXPLORE MORE</a>
    </div>
</section>

<!-- Section 2: Camp with your friends, build some memories Banner -->
<section style="background-image: url('/images/friends-in-sweaters-during-the-outdoor-recreation.jpg'); background-size: cover; background-position: center; padding: 90px 0; text-align: center; position: relative;">
    <div style="position: absolute; inset: 0; background: rgba(21, 42, 41, 0.78);"></div>
    <div class="container position-relative text-white" style="z-index: 2;">
        <span class="sub-badge text-white">Enjoy The Activities</span>
        <h2 class="text-white fw-bold mb-3" style="font-size: 2.4rem;">Camp with your friends, build some memories</h2>
        <p class="text-white-50 small mb-4 mx-auto" style="max-width: 550px;">
            Lacinia bibendum curae maximus molestie tempor urna. Proin augue efficitur fermentum gravida duis pretium integer consectetur est ac sodales.
        </p>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru">
            DISCOVER MORE <i class="bi bi-chevron-right small ms-1"></i>
        </a>
    </div>
</section>

