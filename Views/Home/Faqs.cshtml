@{
    ViewData["Title"] = "Frequently Asked Questions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/faqs.css" asp-append-version="true" />
}

<!-- Hero Banner (Matches faqs.jpg) -->
<section class="inner-hero-banner" style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">
    <div class="inner-hero-overlay"></div>
    <div class="container position-relative">
        <div class="inner-hero-content">
            <div class="breadcrumbs">HOME / FAQS</div>
            <h1>Frequently Asked</h1>
            <div class="sub-text">Get your backpack ready!</div>
        </div>
    </div>
</section>

<!-- Section 1: FAQs & Backpack Graphic -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row g-5">
            <div class="col-lg-5">
                <span class="sub-badge text-teal">FAQs</span>
                <h2 class="fw-bold mb-3">Frequently Asked Questions</h2>
                <p class="text-muted small mb-4">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.
                </p>
                <img src="~/images/blue-hiking-backpack-with-fitness-mat-isolated-on-2021-09-03-13-40-43-utc-1.jpg" alt="Backpack and Boots" class="img-fluid" style="max-height: 280px; object-fit: contain;">
            </div>

            <div class="col-lg-7">
                <div class="accordion" id="faqsAccordionPage">
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#fpage1">
                                1. Where Can I Find Information?
                            </button>
                        </h2>
                        <div id="fpage1" class="accordion-collapse collapse show" data-bs-parent="#faqsAccordionPage">
                            <div class="accordion-body text-muted small">
                                Cubilia porttitor metus scelerisque torquent vestibulum ac id ultrices ex congue montes. In turpis laoreet morbi vivamus eleifend pellentesque vulputate scelerisque.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#fpage2">
                                2. What Are Your Terms And Conditions?
                            </button>
                        </h2>
                        <div id="fpage2" class="accordion-collapse collapse" data-bs-parent="#faqsAccordionPage">
                            <div class="accordion-body text-muted small">
                                Lorem ipsum dolor sit amet consectetur adipiscing elit dolor.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#fpage3">
                                3. Do you ship internationaly?
                            </button>
                        </h2>
                        <div id="fpage3" class="accordion-collapse collapse" data-bs-parent="#faqsAccordionPage">
                            <div class="accordion-body text-muted small">
                                Yes, we offer insured worldwide courier shipping on all camping orders.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#fpage4">
                                4. Can I Buy Directly From The Factory?
                            </button>
                        </h2>
                        <div id="fpage4" class="accordion-collapse collapse" data-bs-parent="#faqsAccordionPage">
                            <div class="accordion-body text-muted small">
                                All our products are available directly through this online store hub.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#fpage5">
                                5. What Kinds of Payment Do You Accept?
                            </button>
                        </h2>
                        <div id="fpage5" class="accordion-collapse collapse" data-bs-parent="#faqsAccordionPage">
                            <div class="accordion-body text-muted small">
                                We accept Visa, MasterCard, Maestro, JCB, PayPal, and Cash on Delivery.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#fpage6">
                                6. When do I receive my order?
                            </button>
                        </h2>
                        <div id="fpage6" class="accordion-collapse collapse" data-bs-parent="#faqsAccordionPage">
                            <div class="accordion-body text-muted small">
                                Standard delivery arrives within 2 to 4 business days.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Go Adventure Banner -->
<section style="background-image: url('/images/tourist-with-a-backpack-against-the-sky-panorama.jpg'); background-size: cover; background-position: center; min-height: 480px; display: flex; align-items: center; position: relative;">
    <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.1) 0%, rgba(21, 42, 41, 0.7) 40%, rgba(21, 42, 41, 0.88) 100%);"></div>
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-end">
            <div class="col-lg-6 col-md-8 text-white">
                <span class="sub-badge text-white">Go Adventure</span>
                <h2 class="text-white fw-bold mb-3" style="font-size: 2.5rem;">
                    Free your spirit, break the chains, Go camp!
                </h2>
                <p class="text-white-50 small mb-4">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.
                </p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru">
                    DISCOVER MORE <i class="bi bi-chevron-right small ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>

