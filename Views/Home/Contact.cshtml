@{
    ViewData["Title"] = "Contact Us";

    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/contact.css" asp-append-version="true" />
}

<!-- =========================
     HERO
========================= -->
<section class="inner-hero-banner"
         style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">

    <div class="inner-hero-overlay"></div>

    <div class="container position-relative">
        <div class="inner-hero-content">

            <div class="breadcrumbs">
                HOME / CONTACT US
            </div>

            <h1>Contact Us</h1>

            <div class="sub-text">
                Get your backpack ready!
            </div>

        </div>
    </div>
</section>

<!-- =========================
     CONTACT SECTION
========================= -->
<section class="contact-section py-5">

    <div class="container py-lg-5">

        <div class="row g-5 align-items-start">

            <!-- =========================
                 LEFT : CONTACT INFORMATION
            ========================= -->
            <div class="col-lg-5">

                <div class="contact-info">

                    <span class="sub-badge text-teal">
                        GET IN TOUCH
                    </span>

                    <h2 class="contact-title">
                        Let's Talk
                        <span>Adventure</span>
                    </h2>

                    <p class="contact-description">
                        Have a question about our camping gear, your order,
                        or need some outdoor advice? We're always happy to help.
                    </p>


                    <!-- Contact Details -->
                    <div class="contact-details mt-4">

                        <!-- Location -->
                        <div class="contact-item">

                            <div class="contact-icon-box">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <div>
                                <h6>Our Location</h6>
                                <p>Amman, Jordan</p>
                            </div>

                        </div>


                    <!-- Phone -->
<div class="contact-item">

    <div class="contact-icon-box">
        <i class="bi bi-telephone-fill"></i>
    </div>

    <a href="tel:+962790000000"
       class="contact-link">

        <h6>Phone</h6>
        <p>+962 7 9000 0000</p>

    </a>

</div>


<!-- Email -->
<div class="contact-item">

    <div class="contact-icon-box">
        <i class="bi bi-envelope-fill"></i>
    </div>

    <a href="mailto:Camping@camptravelgear.com"
       class="contact-link">

        <h6>Email Address</h6>
        <p>Camping@camptravelgear.com</p>

    </a>

</div>

                    </div>

                </div>

            </div>


            <!-- =========================
                 RIGHT : TESTIMONIAL FORM
            ========================= -->
            <div class="col-lg-7">

                <div class="contact-form-box">

                    <div class="mb-4">

                        <span class="sub-badge text-teal">
                            YOUR STORY MATTERS
                        </span>

                        <h2 class="fw-bold mt-2 mb-3">
                            Share Your Experience
                        </h2>

                        <p class="text-muted">
                            Tell us about your adventure and help fellow
                            campers discover better outdoor experiences.
                        </p>

                    </div>

                    <form id="testimonialForm"
      asp-controller="Home"
      asp-action="CreateTestimonial"
      method="post"
      data-logged-in="@isLoggedIn">

    <div class="row g-3">

        <!-- Name -->
        <div class="col-12">

            <label class="form-label">
                Your Name
            </label>

            <input type="text"
                   id="testimonialName"
                   name="Name"
                   class="form-control"
                   placeholder="Enter your name"
                   maxlength="150"
                   required />

        </div>


        <!-- Experience -->
        <div class="col-12">

            <label class="form-label">
                Your Experience
            </label>

            <textarea id="testimonialContent"
                      name="Content"
                      class="form-control"
                      rows="5"
                      maxlength="1000"
                      placeholder="Tell us about your camping experience..."
                      required></textarea>

        </div>


        <!-- Submit -->
        <div class="col-12 mt-3">

            <button type="submit"
                    class="btn btn-barrameru">

                <i class="bi bi-send-fill"></i>
                SHARE MY EXPERIENCE

            </button>

        </div>

    </div>

</form>
              
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     LOGIN REQUIRED MODAL
========================= -->

<div class="modal fade"
     id="loginRequiredModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content login-required-modal">

            <div class="modal-body text-center p-5">

                <div class="login-modal-icon">
                    <i class="bi bi-person-lock"></i>
                </div>

                <h4>
                    Login Required
                </h4>

                <p>
                    You must login first to share your experience.
                </p>

                <div class="d-flex justify-content-center gap-2 mt-4">

                    <button type="button"
                            class="btn btn-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="loginRequiredBtn"
                            class="btn btn-login">
                        Login
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            if (typeof Swal !== "undefined") {

                Swal.fire({
                    icon: "success",
                    title: "Thank You!",
                    text: "Your feedback has been submitted successfully!",
                    confirmButtonText: "OK",
                    confirmButtonColor: "#B67961",
                    customClass: {
                        title: "feedback-success-title"
                    }
                });

            }
        });
    </script>
}
@section Scripts {
    <script src="~/js/pages/contact.js"
            asp-append-version="true"></script>
}