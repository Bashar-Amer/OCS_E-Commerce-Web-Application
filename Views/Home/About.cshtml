@{
    ViewData["Title"] = "About Us";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/about.css" asp-append-version="true" />
}

<!-- Hero Banner (Matches about-us.jpg) -->
<section class="inner-hero-banner" style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">
    <div class="inner-hero-overlay"></div>
    <div class="container position-relative">
        <div class="inner-hero-content">
            <div class="breadcrumbs">HOME / ABOUT US</div>
            <h1>About Us</h1>
            <div class="sub-text">Get your backpack ready!</div>
        </div>
    </div>
</section>

<!-- Section 1: Who We Are -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="sub-badge text-teal">Who We Are</span>
                <h2 class="fw-bold mb-3" style="font-size: 2.2rem; line-height: 1.2;">
                    More than an adventure, its a way of life
                </h2>
                <p class="text-muted small mb-3">
                    Fermentum scelerisque efficitur nostra sociosqu augue elementum litora suscipit dui malesuada. Purus volutpat arcu felis vel libero luctus metus integer.
                </p>
                <p class="text-muted small mb-4">
                    Enim scelerisque si leo amet vitae cras penatibus semper ornare commodo vestibulum.
                </p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru">DISCOVER MORE</a>
            </div>

            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <img src="~/images/back-view-of-a-couple-of-hikers-with-backpack.jpg" alt="Hikers" class="img-fluid w-100" style="height: 380px; object-fit: cover;">
                    </div>
                    <div class="col-sm-6 d-flex flex-column justify-content-between">
                        <img src="~/images/spending-time-by-the-campfire.jpg" alt="Campfire" class="img-fluid w-100 mb-3" style="height: 190px; object-fit: cover;">
                        <div class="quote-box-white flex-grow-1">
                            <div class="quote-mark-teal">“</div>
                            <div class="quote-text-script">
                                Fill your life with adventures, not things. Have stories to tell not stuff to show.
                            </div>
                            <small class="fw-bold text-muted">Heidi B. Smith</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Stats Counter Strip -->
<section class="stats-counter-strip" style="background-image: url('/images/43.jpg');">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-1">20+ Yrs</h2>
                <span class="small text-uppercase font-monospace text-white-50">OF EXPERIENCE</span>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-1">17-Acre</h2>
                <span class="small text-uppercase font-monospace text-white-50">OUTDOOR AREA</span>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-1">14K+</h2>
                <span class="small text-uppercase font-monospace text-white-50">PRODUCT SOLD</span>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-1">97%</h2>
                <span class="small text-uppercase font-monospace text-white-50">HAPPY CUSTOMER</span>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Explore Activities (4 photos) -->
<section class="py-5 bg-white text-center">
    <div class="container py-4">
        <span class="sub-badge text-teal">Select Your Activity</span>
        <h2 class="fw-bold mb-5">Explore Activities</h2>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <img src="~/images/spending-time-by-the-campfire.jpg" alt="Campfire Friends" class="img-fluid w-100" style="height: 260px; object-fit: cover;">
            </div>
            <div class="col-md-6">
                <img src="~/images/paddling-kayaker-on-the-scenic-lake.jpg" alt="Kayaker" class="img-fluid w-100" style="height: 260px; object-fit: cover;">
            </div>
            <div class="col-md-6">
                <img src="~/images/group-of-friends-with-backpacks-doing-trekking-excursion-on-mountain.jpg" alt="Trekking" class="img-fluid w-100" style="height: 260px; object-fit: cover;">
            </div>
            <div class="col-md-6">
                <img src="~/images/happy-asian-young-travellers-with-4wd-drive-car-off-road-in-forest--e1664201038495.jpg" alt="4WD Adventure" class="img-fluid w-100" style="height: 260px; object-fit: cover;">
            </div>
        </div>

        <a asp-controller="Home" asp-action="Adventures" class="btn btn-barrameru">EXPLORE MORE</a>
    </div>
</section>

<!-- Section 4: Go Adventure Banner -->
<section style="background-image: url('/images/tourist-with-a-backpack-against-the-sky-panorama.jpg'); background-size: cover; background-position: center; min-height: 480px; display: flex; align-items: center; position: relative;">
    <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.1) 0%, rgba(21, 42, 41, 0.7) 40%, rgba(21, 42, 41, 0.88) 100%);"></div>
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-end">
            <div class="col-lg-6 col-md-8 text-white">
                <span class="sub-badge text-white">Go Adventure</span>
                <h2 class="text-white fw-bold mb-3" style="font-size: 2.5rem;">
                    Free your spirit, break the chains, Go camp!
                </h2>
                <p class="text-white-50 small mb-4">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.
                </p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru">
                    DISCOVER MORE <i class="bi bi-chevron-right small ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Section 5: Our Value -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="sub-badge text-teal">Our Value</span>
                <h2 class="fw-bold mb-3" style="font-size: 2.2rem;">Nobody is too old for a summer camp</h2>
                <p class="text-muted small mb-4">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.
                </p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru">DISCOVER MORE</a>
            </div>

            <div class="col-lg-7">
                <div class="d-flex align-items-start gap-4 p-4 border rounded-0 mb-3 bg-white shadow-sm">
                    <div class="p-3 text-white rounded-0 flex-shrink-0" style="background-color: #B67961;">
                        <i class="bi bi-lightbulb fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-2">Vision</h5>
                        <p class="text-muted small mb-0">Quis nibh rhoncus habitasse suscipit semper. Mauris ullamcorper posuere ad netus condimentum taciti.</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-4 p-4 border rounded-0 bg-white shadow-sm">
                    <div class="p-3 text-white rounded-0 flex-shrink-0" style="background-color: #B67961;">
                        <i class="bi bi-rocket-takeoff fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-2">Mission</h5>
                        <p class="text-muted small mb-0">Quis nibh rhoncus habitasse suscipit semper. Mauris ullamcorper posuere ad netus condimentum taciti.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 6: Meet The Team (4 members on dark slate) -->
<section class="team-section-dark text-center text-white">
    <div class="container">
        <h2 class="text-white fw-bold mb-5">Meet The Team</h2>
        <div class="row g-4">
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Man1-e1664201497878.jpg" alt="Heidi B. Smith">
                    <h6>Heidi B. Smith</h6>
                    <span>Founder</span>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Woman1-e1664201437817.jpg" alt="Debora Currey">
                    <h6>Debora Currey</h6>
                    <span>Co-Founder</span>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Man2-e1664201483980.jpg" alt="Dan Rodriguez">
                    <h6>Dan Rodriguez</h6>
                    <span>Store Manager</span>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Woman2-e1664201425282.jpg" alt="Jaclyn Pritchard">
                    <h6>Jaclyn Pritchard</h6>
                    <span>Marketing</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/about.js" asp-append-version="true"></script>
}
