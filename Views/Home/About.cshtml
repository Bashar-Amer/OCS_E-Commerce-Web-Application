@{
    ViewData["Title"] = "About Us";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/about.css" asp-append-version="true" />
}

<!-- Hero Banner (Matches about-us.jpg) -->
<section class="inner-hero-banner" style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">
    <div class="inner-hero-overlay"></div>
    <div class="container position-relative">
        <div class="inner-hero-content">
            <div class="breadcrumbs">HOME / ABOUT US</div>
            <h1>About Us</h1>
            <div class="sub-text">Get your backpack ready!</div>
        </div>
    </div>
</section>

<!-- Section 1: Who We Are -->
<!-- =========================================================
     SECTION: WHO WE ARE
========================================================= -->
<section class="about-intro py-5">
    <div class="container py-lg-5">

        <div class="row align-items-center g-5">

            <!-- =========================
                 LEFT: CONTENT
            ========================== -->
            <div class="col-lg-5">

                <span class="sub-badge text-teal">
                    WHO WE ARE
                </span>

                <h2 class="about-title fw-bold mt-3 mb-4">
                    Gear up for your next adventure.
                </h2>

                <p class="about-text mb-3">
                    We believe that every adventure starts with the right gear.
                    Our store brings together reliable outdoor and camping essentials
                    designed to make every trip more comfortable, practical, and memorable.
                </p>

                <p class="about-text mb-4">
                    Whether you're planning a weekend camping trip, a mountain hike,
                    or simply escaping the everyday routine, we're here to help you
                    explore more and worry less.
                </p>

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="btn btn-barrameru px-4 py-3">
                    EXPLORE OUR GEAR
                </a>

              
            </div>
            <!-- =========================
                 RIGHT: IMAGE COLLAGE
            ========================== -->
            <div class="col-lg-7">

                <div class="about-image-grid">

                    <!-- Main image -->
                    <div class="about-image-main">
                        <img src="~/images/back-view-of-a-couple-of-hikers-with-backpack.jpg"
                             alt="Hikers exploring the mountains">
                    </div>

                    <!-- Secondary image -->
                    <div class="about-image-small">
                        <img src="~/images/group-of-smiling-friends-hiking-with-backpacks-outdoors-travel-tourism-hike-and-people-concept.jpg"
                             alt="People enjoying a campfire">
                    </div>
                   
                    <!-- Experience card -->
                    <div class="about-experience-card">

                        <span class="experience-number">
                            ADVENTURE
                        </span>

                        <h5 style="color:var(--secondart)">
                            Explore more.<br>
                            Experience more.
                        </h5>

                        <p>
                            Your journey starts with the right gear.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- Section 2: Stats Counter Strip -->
<!-- Section 2: Why Choose Us Strip -->
<section class="stats-counter-strip" style="background-image: url('/images/43.jpg');">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row text-center g-4">

            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-2">
                    QUALITY
                </h2>
                <span class="small text-uppercase font-monospace text-white-50">
                    GEAR YOU CAN TRUST
                </span>
            </div>

            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-2">
                    ESSENTIAL
                </h2>
                <span class="small text-uppercase font-monospace text-white-50">
                    EVERYTHING YOU NEED
                </span>
            </div>

            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-2">
                    SIMPLE
                </h2>
                <span class="small text-uppercase font-monospace text-white-50">
                    EASY ONLINE SHOPPING
                </span>
            </div>

            <div class="col-6 col-md-3">
                <h2 class="text-white fw-bold mb-2">
                    ADVENTURE
                </h2>
                <span class="small text-uppercase font-monospace text-white-50">
                    MADE TO EXPLORE
                </span>
            </div>

        </div>
    </div>
</section>

<!-- Section 3: Our Values -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">

            <!-- Intro -->
            <div class="col-lg-5">

                <span class="sub-badge text-teal">
                    OUR VALUES
                </span>

                <h2 class="fw-bold mb-3" style="font-size: 2.2rem; line-height: 1.2;">
                    Gear that makes every adventure better
                </h2>

                <p class="text-muted small mb-4" style="line-height: 1.8;">
                    We believe outdoor experiences should be simple, comfortable,
                    and unforgettable. That's why we focus on bringing together
                    practical, reliable gear for every kind of adventure.
                </p>

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="btn btn-barrameru">
                    SHOP OUR GEAR
                </a>

            </div>


            <!-- Values -->
            <div class="col-lg-7">

                <!-- Quality -->
                <div class="d-flex align-items-start gap-4 p-4 border rounded-0 mb-3 bg-white shadow-sm">

                    <div class="p-3 text-white rounded-0 flex-shrink-0"
                         style="background-color: #B67961;">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold mb-2">
                            Quality You Can Trust
                        </h5>

                        <p class="text-muted small mb-0">
                            We carefully choose products that combine quality,
                            practicality, and reliability to support you wherever
                            your adventure takes you.
                        </p>
                    </div>

                </div>


                <!-- Variety -->
                <div class="d-flex align-items-start gap-4 p-4 border rounded-0 mb-3 bg-white shadow-sm">

                    <div class="p-3 text-white rounded-0 flex-shrink-0"
                         style="background-color: #B67961;">
                        <i class="bi bi-grid fs-3"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold mb-2">
                            Everything for the Outdoors
                        </h5>

                        <p class="text-muted small mb-0">
                            From camping essentials to outdoor accessories,
                            we bring the gear you need together in one convenient place.
                        </p>
                    </div>

                </div>


                <!-- Adventure -->
                <div class="d-flex align-items-start gap-4 p-4 border rounded-0 bg-white shadow-sm">

                    <div class="p-3 text-white rounded-0 flex-shrink-0"
                         style="background-color: #B67961;">
                        <i class="bi bi-compass fs-3"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold mb-2">
                            Adventure Comes First
                        </h5>

                        <p class="text-muted small mb-0">
                            We are here to help you spend less time worrying about
                            your equipment and more time enjoying the great outdoors.
                        </p>
                    </div>

                </div>

            </div>

        </div>
    </div>
</section>
<!-- Section 6: Meet The Team (4 members on dark slate) -->
<section class="team-section-dark text-center text-white">
    <div class="container">
        <h2 class="text-white fw-bold mb-5">Meet The Team</h2>
        <div class="row g-4">
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Man1-e1664201497878.jpg" alt="Heidi B. Smith">
                    <h6>Heidi B. Smith</h6>
                    <span>Founder</span>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Woman1-e1664201437817.jpg" alt="Debora Currey">
                    <h6>Debora Currey</h6>
                    <span>Co-Founder</span>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Man2-e1664201483980.jpg" alt="Dan Rodriguez">
                    <h6>Dan Rodriguez</h6>
                    <span>Store Manager</span>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="team-card-box">
                    <img src="~/images/Woman2-e1664201425282.jpg" alt="Jaclyn Pritchard">
                    <h6>Jaclyn Pritchard</h6>
                    <span>Marketing</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/about.js" asp-append-version="true"></script>
}
