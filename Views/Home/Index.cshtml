@model CampTravelGear.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Outdoor Adventure & Camping Store";
}
<form id="globalAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

<!-- 1. Header / Hero Banner (Modern Camping & Outdoor Adventure) -->
<section class="home-hero">

    <div class="home-hero-media">
        <img src="~/images/herosection.png"
             alt="Camping gear in the mountains"
             class="home-hero-img">
        <div class="home-hero-overlay"></div>
    </div>

    <span class="home-hero-corner home-hero-corner-tl"></span>
    <span class="home-hero-corner home-hero-corner-br"></span>

    <div class="container position-relative">

        <div class="home-hero-content">

            <span class="home-hero-eyebrow">
                CAMP • HIKE • EXPLORE
            </span>

            <h1 class="home-hero-title">
                Adventure Starts<br>
                With the Right Gear<span class="home-hero-dot">.</span>
            </h1>

            <p class="home-hero-text">
                Discover reliable camping and outdoor gear made for
                weekend escapes, mountain trails, and unforgettable adventures.
            </p>

            <div class="home-hero-actions">

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="btn-hero-primary">
                    Shop Outdoor Gear
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="home-hero-stats">

                <div class="home-hero-stat">
                    <strong>Quality</strong>
                    <span>Gear you can rely on</span>
                </div>

                <div class="home-hero-stat">
                    <strong>Outdoor</strong>
                    <span>Built for every adventure</span>
                </div>

                <div class="home-hero-stat">
                    <strong>Trusted</strong>
                    <span>Gear for every journey</span>
                </div>

            </div>

        </div>

    </div>

    <a href="#featured"
       class="home-hero-scroll"
       aria-label="Scroll to explore">
        <span></span>
    </a>

</section>

<!-- 2. New Arrivals -->
<section class="py-5 bg-white text-center" id="featured">
    <div class="container py-4">

        <span class="sub-badge text-teal">New Arrival</span>

        <h2 class="fw-bold mb-5">
            Explore Our New Arrivals
        </h2>

        <div class="row g-4">

            @if (Model.NewArrivals.Any())
            {
                @foreach (var p in Model.NewArrivals)
                {
                    <div class="col-6 col-md-6 col-lg-3">

                        <div class="template-product-card">

                            <!-- Product Image Area -->
                            <div class="position-relative">

                                <a href="/Shop/Details/@p.Id">

                                    <img src="@(p.ImageUrl ?? "/images/placeholder.png")"
                                         alt="@p.Name"
                                         class="template-product-img"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='/images/placeholder.png'">

                                </a>

                                <!-- Wishlist -->
                                <button type="button"
                                        class="template-wishlist-btn" data-product-id="@p.Id"
                                        onclick="BarrameruStore.toggleWishlist(@p.Id, { name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', price: @p.Price, image: '@(p.ImageUrl ?? "/images/placeholder.png")' }, this)"
                                        aria-label="Add to wishlist">

                                    <i class="bi bi-heart"></i>

                                </button>

                            </div>

                            <!-- Product Info -->
                            <div>

                                <h6 class="template-product-title">

                                    <a href="/Shop/Details/@p.Id">
                                        @p.Name
                                    </a>

                                </h6>

                                <!-- Rating -->
                                <div class="template-product-rating">

                                    @if (p.AverageRating.HasValue)
                                    {
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= Math.Round(p.AverageRating.Value) ? "bi-star-fill" : "bi-star")"></i>
                                        }

                                        <span class="text-muted ms-1">
                                            (@p.ReviewCount)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No reviews yet
                                        </span>
                                    }

                                </div>

                                <!-- Price -->
                                <div class="template-product-price">
                                    @p.Price.ToString("C")
                                </div>

                            </div>

                            <!-- Add To Cart -->
                            <button type="button"
                                    class="btn btn-template-add-cart"
                                    onclick="BarrameruStore.addToCart(@p.Id, 1, {name:'@p.Name',price:'@p.Price',image:'@(p.ImageUrl ?? "/images/placeholder.png")' },this)">

                                <i class="bi bi-cart3 me-1"></i>
                                Add to cart

                            </button>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <p class="text-muted">
                        No new arrivals yet — check back soon.
                    </p>

                </div>
            }
        </div>

        <!-- View All -->
        <a asp-controller="Shop"
           asp-action="Index"
           class="btn btn-barrameru mt-4">
            VIEW ALL PRODUCTS
        </a>
    </div>
</section>

<!-- 3. Who We Are -->
<section class="py-5 bg-light">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="sub-badge text-teal">Who We Are</span>
                <h2 class="fw-bold mb-3 home-section-title">
                    Adventure Starts Here
                </h2>
                <p class="text-muted small mb-3">
                    We're passionate about the outdoors and believe that every journey is better with the right gear.
                    Our store brings together reliable camping and travel essentials designed for explorers who love
                    to discover, travel, and experience the world.
                </p>
                <p class="text-muted small mb-4">
                    Whether it's a weekend camping trip or a long outdoor adventure, we're here to help you get ready
                    for the journey.
                </p>
                <a asp-controller="Home" asp-action="About" class="btn btn-barrameru">DISCOVER OUR STORY</a>
            </div>

            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <img src="~/images/back-view-of-a-couple-of-hikers-with-backpack.jpg"
                             alt="Hikers" class="img-fluid w-100 home-who-img-tall">
                    </div>
                    <div class="col-sm-6 d-flex flex-column justify-content-between">
                        <img src="~/images/spending-time-by-the-campfire.jpg"
                             alt="Campfire" class="img-fluid w-100 mb-3 home-who-img-short">
                        <div class="quote-box-white flex-grow-1">
                            <div class="quote-mark-teal">&ldquo;</div>
                            <div class="quote-text-script">
                                Fill your life with adventures, not things. Have stories to tell not stuff to show.
                            </div>
                            <small class="fw-bold text-muted">Heidi B. Smith</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. Stats Counter Strip (dynamic, pulled from our own data) -->
<section class="stats-counter-strip" style="background-image: url('/images/43.jpg');">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row text-center g-4">
            <div class="col-6 col-md-4">
                <h2 class="text-white fw-bold mb-1">@Model.Stats.TotalProducts+</h2>
                <span class="fs-5 text-uppercase font-monospace text-white-50">PRODUCTS AVAILABLE</span>
            </div>
            <div class="col-6 col-md-4">
                <h2 class="text-white fw-bold mb-1">@Model.Stats.TotalCategories</h2>
                <span class="fs-5 text-uppercase font-monospace text-white-50">GEAR CATEGORIES</span>
            </div>
            <div class="col-12 col-md-4">
                <h2 class="text-white fw-bold mb-1">@Model.Stats.HappyCustomers+</h2>
                <span class="fs-5 text-uppercase font-monospace text-white-50">CUSTOMERS SERVED</span>
            </div>
        </div>
    </div>
</section>

<!-- 6. Why Choose Us -->
<section class="py-5 bg-white">

    <div class="container py-4">

        <div class="text-center mb-5">

            <span class="sub-badge text-teal">
                What We Offer
            </span>

            <h2 class="fw-bold mb-2">
                Gear for every adventure
            </h2>

            <p class="text-muted small">
                Discover the essentials you need for your next
                outdoor experience.
            </p>

        </div>


        <div class="row g-4">

            <!-- CAMPING -->
            <div class="col-sm-6">
                <div class="about-category-card">

                    <img src="~/images/spending-time-by-the-campfire.jpg"
                         alt="Camping gear">

                    <div class="about-category-content">

                        <h5>
                            Camping Gear
                        </h5>

                        <span>
                            Essentials for comfortable outdoor stays
                        </span>

                    </div>

                </div>
            </div>


            <!-- HIKING -->
            <div class="col-sm-6">
                <div class="about-category-card">

                    <img src="~/images/group-of-friends-with-backpacks-doing-trekking-excursion-on-mountain.jpg"
                         alt="Hiking gear">

                    <div class="about-category-content">

                        <h5>
                            Hiking Gear
                        </h5>

                        <span>
                            Gear for trails, mountains and long walks
                        </span>

                    </div>

                </div>
            </div>


            <!-- WATER ADVENTURES -->
            <div class="col-sm-6">
                <div class="about-category-card">

                    <img src="~/images/paddling-kayaker-on-the-scenic-lake.jpg"
                         alt="Outdoor adventure gear">

                    <div class="about-category-content">

                        <h5>
                            Outdoor Essentials
                        </h5>

                        <span>
                            Practical equipment for outdoor activities
                        </span>

                    </div>

                </div>
            </div>


            <!-- TRAVEL -->
            <div class="col-sm-6">
                <div class="about-category-card">

                    <img src="~/images/happy-asian-young-travellers-with-4wd-drive-car-off-road-in-forest--e1664201038495.jpg"
                         alt="Travel gear">

                    <div class="about-category-content">

                        <h5>
                            Travel Essentials
                        </h5>

                        <span>
                            Smart gear for your next journey
                        </span>

                    </div>

                </div>
            </div>

        </div>


        <div class="text-center mt-5">

            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-barrameru">

                SHOP GEAR

            </a>

        </div>

    </div>

</section>

<!-- 8. Testimonials -->
<section class="testimonial-section">
    <div class="testimonial-bg"
         style="background-image: url('/images/back-view-of-a-couple-of-hikers-with-backpack.jpg');">
    </div>
    <div class="testimonial-overlay"></div>

    <div class="container position-relative text-white" style="z-index: 2;">

        <div class="text-center mb-5">
            <span class="sub-badge text-white">Testimonials</span>

            <h2 class="text-white fw-bold mb-2">
                What They Say
            </h2>

            <p class="text-white-50 small mb-0">
                Real stories from the adventurers who trust our gear in the field.
            </p>
        </div>

        @if (Model.Testimonials.Any())
        {
            <div class="row g-4">
                @foreach (var t in Model.Testimonials)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="testimonial-card">

                            <i class="bi bi-quote testimonial-quote-icon"></i>

                            <p class="testimonial-content">
                                @t.Content
                            </p>

                            <div class="testimonial-footer">
                                <div>
                                    <div class="testimonial-name">
                                        @t.Name
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-white-50 text-center">
                Be the first to share your camping story with us!
            </p>
        }

        <!-- Share Experience Button -->
        <div class="text-center mt-5">
            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-primary testimonial-btn">
                <i class="bi bi-chat-heart me-2"></i>
                Share Your Experience
            </a>
        </div>

    </div>
</section>

<!-- 9. Frequently Asked Questions -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row g-5 align-items-center">

            <div class="col-lg-5">
                <span class="sub-badge text-teal">FAQs</span>

                <h2 class="fw-bold mb-3">Frequently Asked Questions</h2>

                <p class="text-muted small mb-4">
                    Find answers to the most common questions about our camping
                    and travel gear, orders, shipping, and returns.
                </p>
            </div>

            <div class="col-lg-7">
                <div class="accordion" id="homeFaqs">

                    <!-- FAQ 1 -->
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold text-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq1">
                                1. What Camping &amp; Travel Gear Do You Offer?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#homeFaqs">
                            <div class="accordion-body text-muted small">
                                We offer a wide range of camping and travel essentials,
                                including tents, sleeping bags, backpacks, outdoor cooking
                                gear, and other accessories for your adventures.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 2 -->
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq2">
                                2. How Can I Place an Order?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#homeFaqs">
                            <div class="accordion-body text-muted small">
                                Simply browse our products, choose the items you need,
                                add them to your cart, and proceed to checkout to
                                complete your order.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 3 -->
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq3">
                                3. Do You Offer International Shipping?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#homeFaqs">
                            <div class="accordion-body text-muted small">
                                We currently offer shipping to selected locations.
                                Available shipping options and delivery times will
                                be shown during checkout.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 4 -->
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq4">
                                4. Can I Return or Exchange a Product?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#homeFaqs">
                            <div class="accordion-body text-muted small">
                                Yes. Eligible products can be returned or exchanged
                                according to our return policy. Please make sure the
                                product is unused and in its original condition.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 5 -->
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq5">
                                5. What Payment Methods Do You Accept?
                            </button>
                        </h2>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#homeFaqs">
                            <div class="accordion-body text-muted small">
                                We accept the payment methods available at checkout.
                                You can review the available options before completing
                                your order.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 6 -->
                    <div class="accordion-item border rounded-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq6">
                                6. How Long Will My Order Take to Arrive?
                            </button>
                        </h2>
                        <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#homeFaqs">
                            <div class="accordion-body text-muted small">
                                Delivery time depends on your location and the shipping
                                method selected. You will see the estimated delivery time
                                during checkout.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/home.js" asp-append-version="true"></script>
}
