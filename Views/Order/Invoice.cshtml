@model CampTravelGear.Models.Order
@{
    ViewData["Title"] = "Order Invoice Receipt";
    var order = Model;
    string orderId = order != null ? order.Id.ToString() : (ViewBag.OrderId?.ToString() ?? "0");
    var status = order?.Status ?? "Completed";
    var orderDate = order?.OrderDate ?? DateTime.UtcNow;
    var totalAmount = order?.TotalAmount ?? 0m;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/invoice.css" asp-append-version="true" />
}

<!-- Hero Banner (Hidden during Print) -->
<section class="inner-hero-banner d-print-none" style="background-image: url('/images/orange-tourist-tent-illuminated-from-inside-stands-in-mountains-above-clouds.jpg');">
    <div class="inner-hero-overlay"></div>
    <div class="container position-relative">
        <div class="inner-hero-content">
            <div class="breadcrumbs">HOME / SHOP / ORDER INVOICE</div>
            <h1>Order Invoice</h1>
            <div class="sub-text">Thank you for your expedition gear purchase</div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container py-4">
        <!-- Action Buttons -->
        <div class="d-flex justify-content-between align-items-center mb-4 btn-print-hide flex-wrap gap-2">
            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-0 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
            <button type="button" class="btn btn-barrameru btn-sm rounded-0 px-3" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> Print Invoice
            </button>
        </div>

        <!-- Invoice Card -->
        <div class="invoice-card bg-white p-4 p-md-5 border">
            <!-- Header: Logo & Invoice Summary -->
            <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4 flex-wrap gap-3">
                <div>
                    <img src="~/images/Logo_Barrameru.png" alt="Rahhala" style="height: 48px;" class="mb-3">
                    <p class="small text-muted mb-0">
                        <strong>Rahhala Outdoor Club & Camping Gear</strong><br>
                        Queen Rania St<br>
                        Amman - Jordan<br>
                        +962 6 500 2026
                    </p>
                </div>
                <div class="text-md-end">
                    <h3 class="fw-bold text-secondary mb-1" style="letter-spacing: 1px;">INVOICE</h3>
                    <div class="text-muted small">Order ID: <span id="invOrderNumber" class="fw-bold text-dark">#@orderId</span></div>
                    <div class="text-muted small">Date: <span id="invOrderDate">@orderDate.ToString("MMMM dd, yyyy - hh:mm tt")</span></div>
                    
                    @if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success mt-2 px-3 py-1.5 fw-semibold" style="font-size: 11px;">
                            <i class="bi bi-check-circle-fill me-1"></i> PAID / COMPLETED
                        </span>
                    }
                    else if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-danger mt-2 px-3 py-1.5 fw-semibold" style="font-size: 11px;">
                            <i class="bi bi-x-circle-fill me-1"></i> CANCELLED
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark mt-2 px-3 py-1.5 fw-semibold" style="font-size: 11px;">
                            <i class="bi bi-hourglass-split me-1"></i> PROCESSING
                        </span>
                    }
                </div>
            </div>

            <!-- Customer & Shipping Details -->
            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <h6 class="fw-bold text-secondary text-uppercase mb-2" style="font-size: 12px; letter-spacing: 0.5px;">Billed & Shipped To:</h6>
                    <div id="invCustomerName" class="fw-bold text-dark">
                        @(!string.IsNullOrEmpty(order?.User?.FullName) ? order.User.FullName : (!string.IsNullOrEmpty(order?.User?.UserName) ? order.User.UserName : "Registered Customer"))
                    </div>
                    <div id="invCustomerAddress" class="small text-muted">
                        @if (order?.Address != null && !string.IsNullOrEmpty(order.Address.FullAddress))
                        {
                            @($"{order.Address.FullAddress}, {order.Address.City}")
                        }
                        else
                        {
                            <span>124 Mountain Trail Rd, Denver, CO 80201</span>
                        }
                    </div>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h6 class="fw-bold text-secondary text-uppercase mb-2" style="font-size: 12px; letter-spacing: 0.5px;">Payment Method:</h6>
                    <div class="small text-muted">Direct Bank / Credit Card</div>
                    <div class="small text-muted">
                        Status: <span class="fw-bold @(status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "text-success" : "text-dark")">@status</span>
                    </div>
                </div>
            </div>

            <!-- Itemized Equipment Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr class="small fw-bold text-secondary text-uppercase" style="font-size: 11px;">
                            <th>Item Description</th>
                            <th class="text-center" style="width: 15%;">Unit Price</th>
                            <th class="text-center" style="width: 12%;">Qty</th>
                            <th class="text-end" style="width: 18%;">Line Total</th>
                        </tr>
                    </thead>
                    <tbody id="invoiceItemsBody">
                        @if (order?.OrderItems != null && order.OrderItems.Any())
                        {
                            @foreach (var item in order.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@(item.Product?.Name ?? "Outdoor Equipment")</strong>
                                        <div class="small text-muted">@(item.Product?.Category?.Name ?? "General Gear")</div>
                                    </td>
                                    <td class="text-center">$@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end fw-bold text-dark">$@((item.UnitPrice * item.Quantity).ToString("F2"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>
                                    <strong>Black Binoculars</strong>
                                    <div class="small text-muted">Knives & Tools</div>
                                </td>
                                <td class="text-center">$65.00</td>
                                <td class="text-center">1</td>
                                <td class="text-end fw-bold">$65.00</td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Yellow Tent</strong>
                                    <div class="small text-muted">Tent & Accessories</div>
                                </td>
                                <td class="text-center">$65.00</td>
                                <td class="text-center">1</td>
                                <td class="text-end fw-bold">$65.00</td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Camouflage Backpack</strong>
                                    <div class="small text-muted">Bags & Pack</div>
                                </td>
                                <td class="text-center">$140.00</td>
                                <td class="text-center">1</td>
                                <td class="text-end fw-bold">$140.00</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Financial Summary -->
            <div class="row justify-content-end">
                <div class="col-md-5">
                    <div class="d-flex justify-content-between py-1 border-bottom small">
                        <span>Subtotal:</span>
                        <span id="invSubtotal" class="fw-bold">$@totalAmount.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom small">
                        <span>Shipping (Insured Courier):</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <strong class="fs-5 text-secondary">Total Paid:</strong>
                        <strong id="invTotal" class="fs-5" style="color: #B67961;">$@totalAmount.ToString("F2")</strong>
                    </div>
                </div>
            </div>

            <!-- Footer Note -->
            <div class="mt-5 pt-3 border-top text-center text-muted small">
                <p class="mb-0">
                    <i class="bi bi-shield-check text-success me-1"></i>
                    Thank you for choosing Rahhala for your outdoor gear. Enjoy your next adventure!
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/invoice.js" asp-append-version="true"></script>
}
