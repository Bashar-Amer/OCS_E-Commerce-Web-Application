<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rahhala Outdoor Adventure, Camping & Store</title>
    
    <!-- Google Fonts: Montserrat & Rock Salt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Rock+Salt&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- Global Base Stylesheet -->
    <link rel="stylesheet" href="~/css/barrameru-global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Auth State Metadata for Client-Side Storage -->
    <meta name="user-id" content="@(User.Identity?.IsAuthenticated == true ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : "")" />
    <meta name="is-authenticated" content="@(User.Identity?.IsAuthenticated == true ? "true" : "false")" />

    <!-- Page-Specific Stylesheet Section -->
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>
    <!-- Top Header Navigation Bar (Matches barrameru-v1-header.jpg) -->
    <header class="header-barrameru">
        <div class="container position-relative">
            <div class="header-inner">
                <!-- Left Nav Items (Cleaned to only needed real pages) -->
                <nav class="d-none d-lg-block">
                    <ul class="nav-links-left">
                        <li><a asp-controller="Home" asp-action="Index">HOME</a></li>
                        <li><a asp-controller="Shop" asp-action="Index">SHOP</a></li>
                        <li><a asp-controller="Home" asp-action="About">ABOUT US</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">CONTACT</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="fw-bold text-primary">
                                    <i class="bi bi-speedometer2 me-1"></i>ADMIN PORTAL
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                <!-- Mobile Hamburger Toggle -->
                <button class="navbar-toggler d-lg-none border-0 bg-transparent" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavOffcanvas">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <!-- Centered Logo Badge (with curved bottom cutout) -->
                <div class="header-center-logo">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/Logo_Barrameru.png" alt="Rahhala Outdoor Adventure" />
                    </a>
                </div>

                <!-- Right Actions: Animated Search + Cart + User -->
                <div class="header-right-actions">
                    <!-- Expandable Button-to-Bar Search -->
                    <div class="header-search-container" id="headerSearchContainer">
                        <button type="button" class="header-icon-link header-search-trigger" id="headerSearchTrigger" title="Search Store">
                            <i class="bi bi-search"></i>
                        </button>
                        <form asp-controller="Shop" asp-action="Index" method="get" class="header-search-expandable" id="headerSearchForm">
                            <i class="bi bi-search search-inner-icon"></i>
                            <input type="text" name="search" id="headerSearchInput" class="header-search-input-field" placeholder="Search gear, tents, boots..." autocomplete="off" />
                            <button type="button" class="header-search-close" id="headerSearchClose" title="Close Search">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </div>
                    <a asp-controller="Cart" asp-action="Index" class="header-icon-link text-decoration-none" title="Cart" data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart">
                        <i class="bi bi-cart3"></i>
                        <span class="header-cart-badge cart-badge-count">0</span>
                    </a>
                    
                    <!-- Profile / Account Icon -->
                    <div class="dropdown">
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <button class="header-icon-link bg-transparent border-0" type="button" data-bs-toggle="dropdown" title="Admin Dashboard & Account">
                                <i class="bi bi-person-gear text-primary"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end rounded-0 shadow-sm border-0 mt-2">
                                <li class="dropdown-header small text-truncate" style="max-width: 220px;">
                                    <strong>@(User.Identity.Name?.Split('@')[0] ?? "Admin")</strong>
                                    <span class="badge bg-primary text-white ms-1" style="font-size: 10px;">Admin</span>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2 fw-bold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                        <i class="bi bi-box-seam me-2"></i>Manage Products
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                        <i class="bi bi-tags me-2"></i>Manage Categories
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                                        <i class="bi bi-receipt me-2"></i>Manage Orders
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                                        <i class="bi bi-star-half me-2"></i>Reviews &amp; Testimonials
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people me-2"></i>Manage Users
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small py-2" asp-controller="Order" asp-action="Index"><i class="bi bi-clock-history me-2"></i>My Orders</a></li>
                                <li><a class="dropdown-item small py-2" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>My Wishlist</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                        <button type="submit" class="dropdown-item small py-2 text-danger border-0 bg-transparent w-100 text-start"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="header-icon-link bg-transparent border-0" type="button" data-bs-toggle="dropdown" title="My Account">
                                <i class="bi bi-person"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end rounded-0 shadow-sm border-0 mt-2">
                                <li class="dropdown-header small text-truncate" style="max-width: 200px;">
                                    <strong>@(User.Identity.Name?.Split('@')[0] ?? "Member")</strong>
                                </li>
                                <li><a class="dropdown-item small py-2" asp-controller="Order" asp-action="Index"><i class="bi bi-clock-history me-2"></i>My Orders</a></li>
                                <li><a class="dropdown-item small py-2" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>My Wishlist (<span class="wishlist-badge-count">0</span>)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                        <button type="submit" class="dropdown-item small py-2 text-danger border-0 bg-transparent w-100 text-start"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <button class="header-icon-link bg-transparent border-0" type="button" data-bs-toggle="dropdown" title="Account">
                                <i class="bi bi-person"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end rounded-0 shadow-sm border-0 mt-2">
                                <li><a class="dropdown-item small py-2 fw-semibold" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</a></li>
                                <li><a class="dropdown-item small py-2" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus me-2"></i>Register</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small py-2" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>My Wishlist (<span class="wishlist-badge-count">0</span>)</a></li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Offcanvas Menu -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNavOffcanvas">
        <div class="offcanvas-header border-bottom">
            <img src="~/images/Logo_Barrameru.png" alt="Barrameru" style="height: 38px;">
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="list-unstyled">
                <li class="py-2 border-bottom"><a class="fw-bold text-dark text-decoration-none" asp-controller="Home" asp-action="Index">HOME</a></li>
                <li class="py-2 border-bottom"><a class="fw-bold text-dark text-decoration-none" asp-controller="Shop" asp-action="Index">SHOP CATALOG</a></li>
                <li class="py-2 border-bottom"><a class="fw-bold text-dark text-decoration-none" asp-controller="Home" asp-action="About">ABOUT US</a></li>
                <li class="py-2 border-bottom"><a class="fw-bold text-dark text-decoration-none" asp-controller="Home" asp-action="Contact">CONTACT US</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="py-2 border-bottom">
                        <a class="fw-bold text-primary text-decoration-none" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i> ADMIN DASHBOARD
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Search Modal -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-0 p-4">
                <div class="modal-header border-0 p-0 mb-3">
                    <h5 class="modal-title fw-bold">Search Outdoor Gear</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <form asp-controller="Shop" asp-action="Index" method="get">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control rounded-0" placeholder="Type keywords (e.g. Tent, Backpack, Boots)..." autofocus>
                            <button class="btn btn-barrameru" type="submit">SEARCH</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Offcanvas Mini Cart -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCart" style="width: 380px; max-width: 92vw;">
        <div class="offcanvas-header bg-dark text-white px-4 py-3">
            <h6 class="offcanvas-title text-white mb-0"><i class="bi bi-cart3 me-2"></i> Shopping Cart</h6>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
            <div id="miniCartEmpty" class="text-center my-auto" style="display: none;">
                <i class="bi bi-bag-x text-muted" style="font-size: 3rem;"></i>
                <h6 class="mt-3">Your cart is empty!</h6>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-barrameru mt-2 btn-sm">Shop Products</a>
            </div>
            <div id="miniCartItemsContainer" class="flex-grow-1 mini-cart-scroll pe-1">
                <!-- Dynamic items -->
            </div>
            <div class="border-top pt-3 mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold">Subtotal:</span>
                    <strong id="miniCartSubtotal" class="fs-5 text-teal" style="color: #5E959F;"></strong>
                </div>
                <div class="d-grid gap-2">
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary rounded-0 btn-sm">View Cart</a>
                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-barrameru btn-sm">Checkout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main View Content -->
    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-exact-dark" style="background-image: url('/images/mountains-in-colorado.jpg'); background-size: cover; background-position: center; position: relative;">
        <div style="position: absolute; inset: 0; background: rgba(21, 42, 41, 0.94); z-index: 1;"></div>
        <div class="container position-relative" style="z-index: 2;">
            <div class="row g-4">
                <!-- Col 1: Logo + Bio -->
                <div class="col-lg-3 col-md-6">
                    <img src="~/images/Logo_Rahhala_White.svg" alt="Rahhala" style="height: 48px; width: auto; margin-bottom: 16px;">
                    <p class="small text-white-50 mb-3">
                        Rahhala is your premier destination for high-quality camping gear, trekking equipment, and wilderness essentials tailored for passionate explorers.
                    </p>
                    <div class="footer-social-bar">
                        <a href="#" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" title="Twitter / X"><i class="fab fa-x-twitter"></i></a>
                        <a href="#" title="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>

                <!-- Col 2: Customer Care -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-exact-title">Customer Care</h6>
                    <ul class="footer-exact-links">
                        <li><a asp-controller="Order" asp-action="Index">Order History</a></li>
                        <li><a asp-controller="Wishlist" asp-action="Index">My Wishlist</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                    </ul>
                </div>

                <!-- Col 3: Quick Links -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-exact-title">Quick Links</h6>
                    <ul class="footer-exact-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Shop" asp-action="Index">Shop Catalog</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                    </ul>
                </div>

                <!-- Col 4: Reach Us -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-exact-title">Reach Us</h6>
                    <p class="small text-white-50 mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Amman, Jordan</p>
                    <p class="small text-white-50 mb-2"><i class="bi bi-telephone-fill text-primary me-2"></i> +962 7 9000 1234</p>
                    <p class="small text-white-50 mb-2"><i class="bi bi-envelope-fill text-primary me-2"></i> info@rahhala.com</p>
                </div>
            </div>

            <!-- Copyright & Payment Cards -->
            <div class="footer-copyright-bar d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-white-50">
                    Copyright &copy; 2026 Rahhala. All rights reserved.
                </div>
                <div class="d-flex gap-2">
                    <img src="~/images/Visa.jpg" alt="Visa" class="bg-white p-1 rounded" style="height: 22px;">
                    <img src="~/images/Mastercard.jpg" alt="Mastercard" class="bg-white p-1 rounded" style="height: 22px;">
                    <img src="~/images/Maestro.jpg" alt="Maestro" class="bg-white p-1 rounded" style="height: 22px;">
                    <img src="~/images/JCB.jpg" alt="JCB" class="bg-white p-1 rounded" style="height: 22px;">
                    <img src="~/images/Paypal.jpg" alt="Paypal" class="bg-white p-1 rounded" style="height: 22px;">
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Global Store & Shared Scripts -->
    <script src="~/js/barrameru-catalog-data.js" asp-append-version="true"></script>
    <script src="~/js/cart-store.js" asp-append-version="true"></script>
    <script src="~/js/barrameru-global.js" asp-append-version="true"></script>

    <!-- Page-Specific Script Section -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
